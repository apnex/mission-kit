{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:mission-kit:survey-skill-evaluator-source:role-registry",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","hashProfileId","defaultPolicy","budgets","roles"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "hashProfileId":{"const":"survey-evaluator-sha256-jcs-v1"},
    "defaultPolicy":{"const":"deny"},
    "budgets":{
      "type":"object",
      "additionalProperties":false,
      "required":["inputByteLimit","inputTokenLimit","outputByteLimit","outputTokenLimit","referenceHopLimit","toolResultByteLimit","overflowPolicy"],
      "properties":{
        "inputByteLimit":{"type":"integer","minimum":1},
        "inputTokenLimit":{"type":"integer","minimum":1},
        "outputByteLimit":{"type":"integer","minimum":1},
        "outputTokenLimit":{"type":"integer","minimum":1},
        "referenceHopLimit":{"type":"integer","minimum":0,"maximum":1},
        "toolResultByteLimit":{"type":"integer","minimum":1},
        "overflowPolicy":{"const":"typed-continuation-or-hard-failure"}
      }
    },
    "roles":{
      "type":"array",
      "minItems":15,
      "maxItems":15,
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["roleId","awarenessRoleClass","authorizedContents","forbiddenContents","allowedCapabilities","forbiddenCapabilities"],
        "properties":{
          "roleId":{"type":"string","pattern":"^[a-z][a-z0-9-]+$"},
          "awarenessRoleClass":{"type":"boolean"},
          "authorizedContents":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
          "forbiddenContents":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
          "allowedCapabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
          "forbiddenCapabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
        }
      }
    }
  }
}
