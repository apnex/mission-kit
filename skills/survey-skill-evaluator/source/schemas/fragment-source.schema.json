{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:mission-kit:survey-skill-evaluator-source:fragment-source",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","hashProfileId","fragmentId","purpose","rules"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "hashProfileId":{"const":"survey-evaluator-sha256-jcs-v1"},
    "fragmentId":{"type":"string","pattern":"^[a-z][a-z0-9-]*\\.[a-z0-9-]+$"},
    "purpose":{"type":"string","minLength":1},
    "rules":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}
