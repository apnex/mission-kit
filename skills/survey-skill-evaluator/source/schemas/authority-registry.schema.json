{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:mission-kit:survey-skill-evaluator-source:authority-registry",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","hashProfileId","defaultPolicy","authorities"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "hashProfileId":{"const":"survey-evaluator-sha256-jcs-v1"},
    "defaultPolicy":{"const":"deny"},
    "authorities":{
      "type":"array",
      "minItems":1,
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["authorityId","kind","may","mustNot"],
        "properties":{
          "authorityId":{"type":"string","pattern":"^[a-z][a-z0-9-]+$"},
          "kind":{"enum":["external-judgment","deterministic-service","external-deterministic-service"]},
          "may":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
          "mustNot":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
        }
      }
    }
  }
}
