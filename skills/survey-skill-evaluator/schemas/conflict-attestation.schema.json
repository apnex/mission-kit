{"$id":"urn:mission-kit:survey-skill-evaluator:conflict-attestation","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"actorId":{"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$","type":"string"},"admission":{"enum":["admitted","rejected_conflict","rejected_prior_exposure"]},"authorityAttestation":{"additionalProperties":false,"properties":{"authorityId":{"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$","type":"string"},"signature":{"maxLength":4000,"minLength":1,"type":"string"},"statementDigest":{"pattern":"^[a-f0-9]{64}$","type":"string"}},"required":["authorityId","statementDigest","signature"],"type":"object"},"candidateIdentityVisible":{"type":"boolean"},"conflictAttestationId":{"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$","type":"string"},"expectedDirectionVisible":{"type":"boolean"},"hashProfileId":{"const":"survey-evaluator-sha256-jcs-v1"},"incompatibleRoleIds":{"items":{"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$","type":"string"},"type":"array","uniqueItems":true},"priorExposureClasses":{"items":{"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$","type":"string"},"type":"array","uniqueItems":true},"roleId":{"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$","type":"string"},"schemaVersion":{"pattern":"^\\d+\\.\\d+\\.\\d+$","type":"string"}},"required":["schemaVersion","hashProfileId","conflictAttestationId","actorId","roleId","priorExposureClasses","incompatibleRoleIds","candidateIdentityVisible","expectedDirectionVisible","admission","authorityAttestation"],"title":"conflict-attestation","type":"object"}