{"$id":"urn:mission-kit:survey-skill-evaluator:evaluator-assurance-certificate","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"driftConditionDigest":{"pattern":"^[a-f0-9]{64}$","type":"string"},"evaluatorAssuranceCertificateId":{"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$","type":"string"},"evaluatorPackageDigest":{"pattern":"^[a-f0-9]{64}$","type":"string"},"expiresAt":{"format":"date-time","type":"string"},"gateEvidence":{"items":{"additionalProperties":false,"properties":{"gateEvidenceRoot":{"pattern":"^[a-f0-9]{64}$","type":"string"},"gateId":{"pattern":"^E[0-7]$","type":"string"}},"required":["gateId","gateEvidenceRoot"],"type":"object"},"maxItems":8,"minItems":8,"type":"array"},"hashProfileId":{"const":"survey-evaluator-sha256-jcs-v1"},"issuerAttestation":{"additionalProperties":false,"properties":{"authorityId":{"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$","type":"string"},"signature":{"maxLength":4000,"minLength":1,"type":"string"},"statementDigest":{"pattern":"^[a-f0-9]{64}$","type":"string"}},"required":["authorityId","statementDigest","signature"],"type":"object"},"releaseAuthority":{"const":false},"schemaVersion":{"pattern":"^\\d+\\.\\d+\\.\\d+$","type":"string"},"useClass":{"enum":["development","pilot","confirmatory","release_assurance"]},"verdict":{"enum":["certified","denied","withdrawn"]}},"required":["schemaVersion","hashProfileId","evaluatorAssuranceCertificateId","evaluatorPackageDigest","gateEvidence","useClass","expiresAt","driftConditionDigest","verdict","issuerAttestation","releaseAuthority"],"title":"evaluator-assurance-certificate","type":"object"}