{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:authoring:schema:authoring-workspace-effect:v1alpha1",
  "title": "Mission Kit authoring WorkspaceEffect value v1alpha1",
  "description": "Closed, journal-owned persistence effect for one atomic authoring commit. This is a value object, not a standalone resource entity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "retainedResources",
    "historyReferences",
    "openAssignment",
    "activeHeads",
    "dependencyEdges",
    "handoffProducts",
    "handoffSlots"
  ],
  "properties": {
    "retainedResources": {
      "type": "array",
      "maxItems": 16384,
      "items": {"$ref": "#/$defs/resourceIntegrityBinding"}
    },
    "historyReferences": {
      "type": "array",
      "maxItems": 32768,
      "items": {
        "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
      }
    },
    "openAssignment": {"$ref": "#/$defs/openAssignmentEffect"},
    "activeHeads": {"$ref": "#/$defs/slotReferenceBoundary"},
    "dependencyEdges": {"$ref": "#/$defs/dependencyEdgeBoundary"},
    "handoffProducts": {"$ref": "#/$defs/slotReferenceBoundary"},
    "handoffSlots": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/slotId"
      }
    }
  },
  "$defs": {
    "resourceIntegrityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "integrityDigest"],
      "properties": {
        "reference": {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        "integrityDigest": {
          "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"
        }
      }
    },
    "openAssignmentEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/assignmentBinding"}
          ]
        },
        "after": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/assignmentBinding"}
          ]
        }
      }
    },
    "assignmentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "assignmentDigest"],
      "properties": {
        "reference": {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        "assignmentDigest": {
          "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"
        }
      }
    },
    "slotReferenceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/SlotReference"
          }
        },
        "after": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/SlotReference"
          }
        }
      }
    },
    "dependencyEdgeBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {
          "type": "array",
          "maxItems": 32768,
          "items": {
            "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DependencyEdge"
          }
        },
        "after": {
          "type": "array",
          "maxItems": 32768,
          "items": {
            "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DependencyEdge"
          }
        }
      }
    }
  }
}
