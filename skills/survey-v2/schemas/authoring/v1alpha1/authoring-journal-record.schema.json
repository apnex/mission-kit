{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:authoring:schema:authoring-journal-record:v1alpha1",
  "title": "Mission Kit authoring journal record v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordDigest",
    "commitId",
    "ordinal",
    "commitKind",
    "actor",
    "authority",
    "idempotency",
    "commandDigest",
    "payloadDigest",
    "previousSealDigest",
    "before",
    "after",
    "mutationDigest",
    "machineEdges"
  ],
  "properties": {
    "recordDigest": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"},
    "commitId": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/semanticId"},
    "ordinal": {"type": "integer", "minimum": 1},
    "commitKind": {"enum": ["evidence", "transition"]},
    "actor": {"$ref": "#/$defs/actor"},
    "authority": {"$ref": "#/$defs/authority"},
    "idempotency": {"$ref": "#/$defs/idempotency"},
    "commandDigest": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"},
    "payloadDigest": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"},
    "previousSealDigest": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"},
    "before": {"$ref": "#/$defs/revisionState"},
    "after": {"$ref": "#/$defs/revisionState"},
    "mutationDigest": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"},
    "machineEdges": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/machineEdge"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "commitKind": {"const": "evidence"}
        },
        "required": ["commitKind"]
      },
      "then": {
        "properties": {
          "machineEdges": {"type": "array", "maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "commitKind": {"const": "transition"}
        },
        "required": ["commitKind"]
      },
      "then": {
        "properties": {
          "machineEdges": {"type": "array", "minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "id"],
      "properties": {
        "class": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/semanticId"},
        "id": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/semanticId"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "id", "policy"],
      "properties": {
        "class": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/semanticId"},
        "id": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/semanticId"},
        "policy": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DigestBinding"}
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machineId", "key"],
      "properties": {
        "machineId": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/semanticId"},
        "key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      }
    },
    "revisionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticRevision",
        "evidenceRevision",
        "semanticStateDigest"
      ],
      "properties": {
        "semanticRevision": {"type": "integer", "minimum": 0},
        "evidenceRevision": {"type": "integer", "minimum": 0},
        "semanticStateDigest": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"}
      }
    },
    "machineEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machineId",
        "transitionId",
        "fromState",
        "eventId",
        "toState",
        "beforeStateDigest",
        "afterStateDigest"
      ],
      "properties": {
        "machineId": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/semanticId"},
        "transitionId": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/transitionId"},
        "fromState": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/stateId"},
        "eventId": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/eventId"},
        "toState": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/stateId"},
        "beforeStateDigest": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"},
        "afterStateDigest": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"}
      }
    }
  }
}
