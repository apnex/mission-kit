{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:authoring:schema:authoring-form-definition:v1alpha1",
  "title": "Mission Kit AuthoringFormDefinition resource v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "authoring.mission-kit/v1alpha1"},
    "kind": {"const": "AuthoringFormDefinition"},
    "metadata": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formDigest", "grammarVersion", "title", "fields"],
      "properties": {
        "formDigest": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"},
        "grammarVersion": {"const": "mission-kit-authoring-text/v1"},
        "title": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/nonEmptyText"},
        "introduction": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/nonEmptyText"},
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"$ref": "#/$defs/field"}
        }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordinal",
        "heading",
        "type",
        "required",
        "placeholder",
        "constraints"
      ],
      "properties": {
        "id": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/fieldId"},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 128},
        "heading": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S"},
        "instruction": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"},
        "type": {"enum": ["paragraph", "string-list", "enum", "boolean"]},
        "required": {"type": "boolean"},
        "placeholder": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S"},
        "constraints": {
          "oneOf": [
            {"$ref": "#/$defs/paragraphConstraints"},
            {"$ref": "#/$defs/stringListConstraints"},
            {"$ref": "#/$defs/enumConstraints"},
            {"$ref": "#/$defs/booleanConstraints"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "paragraph"}}, "required": ["type"]},
          "then": {"properties": {"constraints": {"$ref": "#/$defs/paragraphConstraints"}}}
        },
        {
          "if": {"properties": {"type": {"const": "string-list"}}, "required": ["type"]},
          "then": {"properties": {"constraints": {"$ref": "#/$defs/stringListConstraints"}}}
        },
        {
          "if": {"properties": {"type": {"const": "enum"}}, "required": ["type"]},
          "then": {"properties": {"constraints": {"$ref": "#/$defs/enumConstraints"}}}
        },
        {
          "if": {"properties": {"type": {"const": "boolean"}}, "required": ["type"]},
          "then": {"properties": {"constraints": {"$ref": "#/$defs/booleanConstraints"}}}
        }
      ]
    },
    "paragraphConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minLength", "maxLength"],
      "properties": {
        "minLength": {"type": "integer", "minimum": 0, "maximum": 65536},
        "maxLength": {"type": "integer", "minimum": 1, "maximum": 65536}
      }
    },
    "stringListConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minItems",
        "maxItems",
        "itemMinLength",
        "itemMaxLength",
        "uniqueItems"
      ],
      "properties": {
        "minItems": {"type": "integer", "minimum": 0, "maximum": 1024},
        "maxItems": {"type": "integer", "minimum": 1, "maximum": 1024},
        "itemMinLength": {"type": "integer", "minimum": 0, "maximum": 4096},
        "itemMaxLength": {"type": "integer", "minimum": 1, "maximum": 4096},
        "uniqueItems": {"const": true}
      }
    },
    "enumConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["members"],
      "properties": {
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      }
    },
    "booleanConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trueLiteral", "falseLiteral"],
      "properties": {
        "trueLiteral": {"const": "yes"},
        "falseLiteral": {"const": "no"}
      }
    }
  }
}
