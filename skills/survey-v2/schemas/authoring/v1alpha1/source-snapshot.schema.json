{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:authoring:schema:source-snapshot:v1alpha1",
  "title": "Mission Kit SourceSnapshot resource v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "authoring.mission-kit/v1alpha1"},
    "kind": {"const": "SourceSnapshot"},
    "metadata": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceDigest", "provenance", "inventory"],
      "properties": {
        "sourceDigest": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "inventory": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/inventoryItem"}
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceClass", "sourceId"],
      "properties": {
        "sourceClass": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/semanticId"},
        "sourceId": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/semanticId"},
        "revision": {"type": "string", "minLength": 1, "maxLength": 160},
        "evidenceDigest": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"}
      }
    },
    "inventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "logicalName", "content", "rawEvidenceDigest"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 256},
        "logicalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "content": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/ExactBytes"},
        "rawEvidenceDigest": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"}
      }
    }
  }
}
