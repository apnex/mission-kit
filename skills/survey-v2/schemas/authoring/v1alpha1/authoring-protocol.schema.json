{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:authoring:schema:authoring-protocol:v1alpha1",
  "title": "Mission Kit AuthoringProtocol resource v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "authoring.mission-kit/v1alpha1"},
    "kind": {"const": "AuthoringProtocol"},
    "metadata": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialState", "states", "events", "guards", "transitions"],
      "properties": {
        "initialState": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/stateId"},
        "states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/state"}
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/event"}
        },
        "guards": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/guard"}
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/transition"}
        }
      }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "class"],
      "properties": {
        "id": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/stateId"},
        "label": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/nonEmptyText"},
        "class": {"enum": ["task", "wait", "terminal"]},
        "taskId": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/semanticId"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/eventId"},
        "description": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/nonEmptyText"}
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/semanticId"},
        "description": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/nonEmptyText"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "eventId", "toState", "guardIds"],
      "properties": {
        "id": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/transitionId"},
        "source": {
          "oneOf": [
            {"$ref": "#/$defs/singleSource"},
            {"$ref": "#/$defs/sourceSet"}
          ]
        },
        "eventId": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/eventId"},
        "toState": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/stateId"},
        "guardIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/semanticId"}
        }
      }
    },
    "singleSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "stateId"],
      "properties": {
        "mode": {"const": "single"},
        "stateId": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/stateId"}
      }
    },
    "sourceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "stateIds"],
      "properties": {
        "mode": {"const": "set"},
        "stateIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/stateId"}
        }
      }
    }
  }
}
