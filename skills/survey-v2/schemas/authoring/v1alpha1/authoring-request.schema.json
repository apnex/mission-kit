{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:authoring:schema:authoring-request:v1alpha1",
  "title": "Mission Kit AuthoringRequest resource v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "authoring.mission-kit/v1alpha1"},
    "kind": {"const": "AuthoringRequest"},
    "metadata": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestDigest",
        "operation",
        "base",
        "contextClosure",
        "submissionContract",
        "bindings"
      ],
      "properties": {
        "requestDigest": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"},
        "operation": {
          "oneOf": [
            {"$ref": "#/$defs/taskSubmissionOperation"},
            {"$ref": "#/$defs/revisionOperation"}
          ]
        },
        "base": {"$ref": "#/$defs/base"},
        "contextClosure": {"$ref": "#/$defs/contextClosure"},
        "submissionContract": {"$ref": "#/$defs/submissionContract"},
        "bindings": {"$ref": "#/$defs/bindings"}
      }
    }
  },
  "$defs": {
    "taskSubmissionOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "task", "target", "inputs"],
      "properties": {
        "class": {"const": "task-submission"},
        "task": {"$ref": "#/$defs/task"},
        "target": {"$ref": "#/$defs/target"},
        "inputs": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/fieldId"
          },
          "additionalProperties": {
            "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
          }
        }
      }
    },
    "revisionOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "normalTaskId",
        "unit",
        "plan",
        "expectedHeads",
        "inputs"
      ],
      "properties": {
        "class": {"const": "revision"},
        "normalTaskId": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/semanticId"},
        "unit": {"$ref": "#/$defs/revisionUnitBinding"},
        "plan": {"$ref": "#/$defs/revisionPlanBinding"},
        "expectedHeads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/SlotReference"}
        },
        "inputs": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/fieldId"
          },
          "additionalProperties": {
            "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
          }
        }
      }
    },
    "revisionUnitBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/semanticId"},
        "digest": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"}
      }
    },
    "revisionPlanBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/semanticId"},
        "digest": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stateId", "transitionId", "eventId"],
      "properties": {
        "id": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/semanticId"},
        "stateId": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/stateId"},
        "transitionId": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/transitionId"},
        "eventId": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/eventId"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "resourceType", "cardinality"],
      "properties": {
        "slot": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/slotId"},
        "resourceType": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/ResourceType"},
        "cardinality": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/Cardinality"}
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoringState", "semanticRevision", "semanticStateDigest"],
      "properties": {
        "authoringState": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/stateId"},
        "semanticRevision": {"type": "integer", "minimum": 0},
        "semanticStateDigest": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"}
      }
    },
    "contextClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "closureDigest"],
      "properties": {
        "reference": {"$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"},
        "closureDigest": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"}
      }
    },
    "submissionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "validatorSet", "form"],
      "properties": {
        "schema": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DigestBinding"},
        "validatorSet": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DigestBinding"},
        "form": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DigestBinding"}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel",
        "profile",
        "protocol",
        "handler",
        "parser",
        "form",
        "schema",
        "validatorSet",
        "projection"
      ],
      "properties": {
        "kernel": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DigestBinding"},
        "profile": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DigestBinding"},
        "protocol": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DigestBinding"},
        "handler": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DigestBinding"},
        "parser": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DigestBinding"},
        "form": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DigestBinding"},
        "schema": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DigestBinding"},
        "validatorSet": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DigestBinding"},
        "projection": {"$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DigestBinding"}
      }
    }
  }
}
