{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:authoring:schema:common:v1alpha1",
  "title": "Mission Kit authoring common definitions v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "apiVersion": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9.-]*/v[0-9]+(?:alpha[0-9]+|beta[0-9]+)?$"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "resourceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)*$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/resourceName"
        },
        "labels": {
          "$ref": "#/$defs/stringMap"
        },
        "annotations": {
          "$ref": "#/$defs/stringMap"
        }
      }
    },
    "stringMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._/-]*[A-Za-z0-9])?$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      },
      "maxProperties": 64
    },
    "stateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
    },
    "transitionId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "^[A-Z][A-Z0-9]*$"
    },
    "semanticId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$"
    },
    "slotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$"
    },
    "roleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "fieldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "fieldPath": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "DigestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/semanticId"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "ResourceType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind"
      ],
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        }
      }
    },
    "Cardinality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        }
      }
    },
    "canonicalValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/canonicalValue"
          }
        },
        {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "$ref": "#/$defs/canonicalValue"
          }
        }
      ]
    },
    "ExactBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mediaType",
        "encoding",
        "byteLength",
        "data"
      ],
      "properties": {
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+(?:;[A-Za-z0-9!#$&^_.+ -]+=[A-Za-z0-9!#$&^_.+ -]+)*$"
        },
        "encoding": {
          "const": "base64"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "data": {
          "type": "string",
          "maxLength": 1398104,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "ResourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "spec": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "$ref": "#/$defs/canonicalValue"
          }
        },
        "status": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "$ref": "#/$defs/canonicalValue"
          }
        },
        "evidence": {
          "type": "object",
          "maxProperties": 4096,
          "additionalProperties": {
            "$ref": "#/$defs/canonicalValue"
          }
        }
      }
    },
    "StoredResourceVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "integrityDigest",
        "resource"
      ],
      "properties": {
        "reference": {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        "integrityDigest": {
          "$ref": "#/$defs/digest"
        },
        "resource": {
          "$ref": "#/$defs/ResourceDocument"
        }
      }
    },
    "SlotReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "reference"
      ],
      "properties": {
        "slot": {
          "$ref": "#/$defs/slotId"
        },
        "reference": {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        }
      }
    },
    "DependencyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "relation"
      ],
      "properties": {
        "from": {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        "to": {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        "relation": {
          "$ref": "#/$defs/semanticId"
        }
      }
    }
  }
}
