{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey-v2:schema:dependency:v1",
  "title": "Survey v2 typed dependency",
  "oneOf": [
    {"$ref": "#/$defs/reference"},
    {"$ref": "#/$defs/skill"},
    {"$ref": "#/$defs/process"}
  ],
  "$defs": {
    "hook": {
      "enum": [
        "init-resolve",
        "pre-r1-freeze",
        "commit-r1",
        "pre-r2-freeze",
        "commit-r2",
        "pre-candidate",
        "rehydrate"
      ]
    },
    "jsonScalar": {
      "type": ["string", "number", "boolean", "null"]
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["present"],
          "properties": {
            "present": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["equals"],
          "properties": {
            "equals": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fact", "value"],
              "properties": {
                "fact": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "$ref": "#/$defs/jsonScalar"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["in"],
          "properties": {
            "in": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fact", "values"],
              "properties": {
                "fact": {
                  "type": "string",
                  "minLength": 1
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/jsonScalar"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contains"],
          "properties": {
            "contains": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fact", "value"],
              "properties": {
                "fact": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "$ref": "#/$defs/jsonScalar"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["allOf"],
          "properties": {
            "allOf": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["anyOf"],
          "properties": {
            "anyOf": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": {
            "not": {
              "$ref": "#/$defs/predicate"
            }
          }
        }
      ]
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stability"],
      "properties": {
        "stability": {
          "enum": ["initialization-stable", "phase-sensitive"]
        },
        "present": {
          "type": "string",
          "minLength": 1
        },
        "equals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fact", "value"],
          "properties": {
            "fact": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "$ref": "#/$defs/jsonScalar"
            }
          }
        },
        "in": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fact", "values"],
          "properties": {
            "fact": {
              "type": "string",
              "minLength": 1
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/jsonScalar"
              }
            }
          }
        },
        "contains": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fact", "value"],
          "properties": {
            "fact": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "$ref": "#/$defs/jsonScalar"
            }
          }
        },
        "allOf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/predicate"
          }
        },
        "anyOf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/predicate"
          }
        },
        "not": {
          "$ref": "#/$defs/predicate"
        }
      },
      "oneOf": [
        {"properties": {"present": true}, "required": ["present"]},
        {"properties": {"equals": true}, "required": ["equals"]},
        {"properties": {"in": true}, "required": ["in"]},
        {"properties": {"contains": true}, "required": ["contains"]},
        {"properties": {"allOf": true}, "required": ["allOf"]},
        {"properties": {"anyOf": true}, "required": ["anyOf"]},
        {"properties": {"not": true}, "required": ["not"]}
      ]
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "capabilities"],
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^R(?:0[1-9]|1[0-9]|2[0-8])$"
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]+$"
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unavailable",
        "invalid",
        "incompatible",
        "incomplete",
        "sourceUnstable",
        "trustBoundaryViolation"
      ],
      "properties": {
        "unavailable": {
          "const": "block-recoverable"
        },
        "invalid": {
          "const": "block-recoverable-before-snapshot"
        },
        "incompatible": {
          "const": "block-recoverable-before-snapshot"
        },
        "incomplete": {
          "const": "block-recoverable-before-snapshot"
        },
        "sourceUnstable": {
          "const": "block-recoverable"
        },
        "trustBoundaryViolation": {
          "const": "block-terminal"
        }
      }
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^urn:mission-kit:survey-v2:[a-z0-9][a-z0-9:#-]*$"
        }
      }
    },
    "genericCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaMajor", "requiredCapabilities"],
      "properties": {
        "schemaMajor": {
          "const": 1
        },
        "requiredCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]+$"
          }
        }
      }
    },
    "genericPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loadMode", "retry", "actorToolBoundary"],
      "properties": {
        "loadMode": {
          "enum": ["full-skill", "declared-process"]
        },
        "retry": {
          "const": "declared-failure-class"
        },
        "actorToolBoundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resolve", "execute", "ratify"],
          "properties": {
            "resolve": {
              "const": "deterministic-runtime"
            },
            "execute": {
              "enum": ["deterministic-runtime", "proposer"]
            },
            "ratify": {
              "const": "director-only"
            }
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "id",
        "kind",
        "schemaVersion",
        "purpose",
        "applicability",
        "requirement",
        "source",
        "selector",
        "snapshotPolicy",
        "compatibility",
        "resolution",
        "evaluateAt",
        "resolveBy",
        "executeAt",
        "consumeBy",
        "policy",
        "contribution",
        "failure",
        "outputContract"
      ],
      "properties": {
        "$schema": {
          "const": "urn:mission-kit:survey-v2:schema:dependency:v1"
        },
        "id": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/semanticId"
        },
        "kind": {
          "const": "reference"
        },
        "schemaVersion": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/schemaVersion"
        },
        "purpose": {
          "type": "string",
          "minLength": 12
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "requirement": {
          "enum": ["required", "optional"]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository"],
          "properties": {
            "kind": {
              "const": "git-repository"
            },
            "repository": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": {
              "const": "subdirectory"
            },
            "path": {
              "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/relativePath"
            }
          }
        },
        "snapshotPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "captureAt",
            "stability",
            "storage",
            "maxFiles",
            "maxFileBytes",
            "maxTotalBytes"
          ],
          "properties": {
            "captureAt": {
              "const": "init-resolve"
            },
            "stability": {
              "const": "two-full-byte-passes"
            },
            "storage": {
              "const": "session-event-bytes"
            },
            "maxFiles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            "maxFileBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "maxTotalBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144
            }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredIndex", "entryPattern", "mediaType"],
          "properties": {
            "requiredIndex": {
              "const": "README.md"
            },
            "entryPattern": {
              "type": "object",
              "additionalProperties": false,
              "required": ["syntax", "expression"],
              "properties": {
                "syntax": {
                  "const": "ecmascript-regexp"
                },
                "expression": {
                  "const": "^A[0-9]+-[^/]+\\.md$"
                }
              }
            },
            "mediaType": {
              "const": "text/markdown"
            }
          }
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bindingKey", "allowed"],
          "properties": {
            "bindingKey": {
              "const": "mission-kit.axioms"
            },
            "allowed": {
              "const": ["host-registry"]
            }
          }
        },
        "evaluateAt": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hook"
          }
        },
        "resolveBy": {
          "$ref": "#/$defs/hook"
        },
        "executeAt": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hook"
          }
        },
        "consumeBy": {
          "$ref": "#/$defs/hook"
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["loadMode", "retry", "actorToolBoundary"],
          "properties": {
            "loadMode": {
              "const": "selected-documents-in-full"
            },
            "retry": {
              "const": "declared-failure-class"
            },
            "actorToolBoundary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["resolveAndObserve", "selectAndMap", "ratify"],
              "properties": {
                "resolveAndObserve": {
                  "const": "deterministic-runtime"
                },
                "selectAndMap": {
                  "const": "proposer"
                },
                "ratify": {
                  "const": "director-only"
                }
              }
            }
          }
        },
        "contribution": {
          "$ref": "#/$defs/contribution"
        },
        "failure": {
          "$ref": "#/$defs/failure"
        },
        "outputContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema"],
          "properties": {
            "schema": {
              "const": "urn:mission-kit:survey-v2:schema:dependency:v1#/$defs/reference-resolution-output"
            }
          }
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "id",
        "kind",
        "schemaVersion",
        "purpose",
        "applicability",
        "requirement",
        "source",
        "compatibility",
        "evaluateAt",
        "resolveBy",
        "executeAt",
        "consumeBy",
        "policy",
        "contribution",
        "failure",
        "outputContract"
      ],
      "properties": {
        "$schema": {
          "const": "urn:mission-kit:survey-v2:schema:dependency:v1"
        },
        "id": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/semanticId"
        },
        "kind": {
          "const": "skill"
        },
        "schemaVersion": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/schemaVersion"
        },
        "purpose": {
          "type": "string",
          "minLength": 12
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "requirement": {
          "enum": ["required", "optional"]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "skillId"],
          "properties": {
            "kind": {
              "const": "codex-skill"
            },
            "skillId": {
              "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/semanticId"
            }
          }
        },
        "compatibility": {
          "$ref": "#/$defs/genericCompatibility"
        },
        "evaluateAt": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hook"}
        },
        "resolveBy": {"$ref": "#/$defs/hook"},
        "executeAt": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hook"}
        },
        "consumeBy": {"$ref": "#/$defs/hook"},
        "policy": {"$ref": "#/$defs/genericPolicy"},
        "contribution": {"$ref": "#/$defs/contribution"},
        "failure": {"$ref": "#/$defs/failure"},
        "outputContract": {"$ref": "#/$defs/outputContract"}
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "id",
        "kind",
        "schemaVersion",
        "purpose",
        "applicability",
        "requirement",
        "source",
        "compatibility",
        "evaluateAt",
        "resolveBy",
        "executeAt",
        "consumeBy",
        "policy",
        "contribution",
        "failure",
        "outputContract"
      ],
      "properties": {
        "$schema": {
          "const": "urn:mission-kit:survey-v2:schema:dependency:v1"
        },
        "id": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/semanticId"
        },
        "kind": {
          "const": "triangulation-process"
        },
        "schemaVersion": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/schemaVersion"
        },
        "purpose": {
          "type": "string",
          "minLength": 12
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "requirement": {
          "enum": ["required", "optional"]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "processId"],
          "properties": {
            "kind": {
              "const": "declared-process"
            },
            "processId": {
              "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/semanticId"
            }
          }
        },
        "compatibility": {
          "$ref": "#/$defs/genericCompatibility"
        },
        "evaluateAt": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hook"}
        },
        "resolveBy": {"$ref": "#/$defs/hook"},
        "executeAt": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hook"}
        },
        "consumeBy": {"$ref": "#/$defs/hook"},
        "policy": {"$ref": "#/$defs/genericPolicy"},
        "contribution": {"$ref": "#/$defs/contribution"},
        "failure": {"$ref": "#/$defs/failure"},
        "outputContract": {"$ref": "#/$defs/outputContract"}
      }
    },
    "reference-resolution-item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "type",
        "mode",
        "mediaType",
        "contentEncoding",
        "content",
        "byteLength",
        "digest"
      ],
      "properties": {
        "path": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/relativePath"
        },
        "type": {"const": "regular-file"},
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "mediaType": {
          "enum": ["text/markdown", "application/octet-stream"]
        },
        "contentEncoding": {
          "enum": ["utf8", "base64"]
        },
        "content": {"type": "string"},
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "digest": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/digest"
        }
      }
    },
    "reference-resolution-output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependencyId",
        "repository",
        "selector",
        "inventory",
        "inventoryDigest",
        "aggregateDigest",
        "capturedAt"
      ],
      "properties": {
        "dependencyId": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/semanticId"
        },
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
        },
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": {"const": "subdirectory"},
            "path": {
              "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/relativePath"
            }
          }
        },
        "inventory": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/reference-resolution-item"
          }
        },
        "inventoryDigest": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/digest"
        },
        "aggregateDigest": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/digest"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
