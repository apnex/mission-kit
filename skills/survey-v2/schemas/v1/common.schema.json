{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey-v2:schema:common:v1",
  "title": "Survey v2 common definitions",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "semanticId": {
      "type": "string",
      "pattern": "^urn:mission-kit:survey-v2:[a-z0-9][a-z0-9:-]*$"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "ref", "assertionSource"],
      "properties": {
        "role": {
          "enum": ["proposer", "director", "substrate", "host"]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "assertionSource": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
