{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey-v2:schema:envelope-model:v1",
  "title": "Survey v2 self-contained intent envelope model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "title",
    "workItem",
    "methodology",
    "authority",
    "outcomeAxes",
    "instrument",
    "responses",
    "interpretations",
    "contradictions",
    "tensions",
    "compositeIntent",
    "scope",
    "antiGoals",
    "openDesignQuestions",
    "dependencies",
    "calibration",
    "ratification",
    "lifecycleHandoff"
  ],
  "properties": {
    "$schema": {
      "const": "urn:mission-kit:survey-v2:schema:envelope-model:v1"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "workItem": {
      "type": "string",
      "minLength": 1
    },
    "methodology": {
      "$ref": "#/$defs/methodology"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "outcomeAxes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "instrument": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"$ref": "urn:mission-kit:survey-v2:schema:instrument:v1#/$defs/question"},
        {"$ref": "urn:mission-kit:survey-v2:schema:instrument:v1#/$defs/question"},
        {"$ref": "urn:mission-kit:survey-v2:schema:instrument:v1#/$defs/question"},
        {"$ref": "urn:mission-kit:survey-v2:schema:instrument:v1#/$defs/question"},
        {"$ref": "urn:mission-kit:survey-v2:schema:instrument:v1#/$defs/question"},
        {"$ref": "urn:mission-kit:survey-v2:schema:instrument:v1#/$defs/question"}
      ],
      "items": false
    },
    "responses": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"$ref": "#/$defs/response"},
        {"$ref": "#/$defs/response"},
        {"$ref": "#/$defs/response"},
        {"$ref": "#/$defs/response"},
        {"$ref": "#/$defs/response"},
        {"$ref": "#/$defs/response"}
      ],
      "items": false
    },
    "interpretations": {
      "$ref": "#/$defs/interpretations"
    },
    "contradictions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "tensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "compositeIntent": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "antiGoals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "openDesignQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependencyEvidence"
      }
    },
    "calibration": {
      "$ref": "#/$defs/calibration"
    },
    "ratification": {
      "$ref": "#/$defs/ratification"
    },
    "lifecycleHandoff": {
      "$ref": "#/$defs/lifecycleHandoff"
    }
  },
  "$defs": {
    "digest": {
      "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/digest"
    },
    "jsonValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string"},
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {"$ref": "#/$defs/semanticRecord"}
      ]
    },
    "semanticRecord": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "$ref": "#/$defs/jsonValue"
        }
      },
      "additionalProperties": false
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "schemaVersion",
        "protocolDigest",
        "projectionDigest"
      ],
      "properties": {
        "name": {
          "const": "Survey v2"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "protocolDigest": {
          "$ref": "#/$defs/digest"
        },
        "projectionDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directorRef",
        "proposerRef",
        "bindingEvidence",
        "ratificationAuthority"
      ],
      "properties": {
        "directorRef": {
          "type": "string",
          "minLength": 1
        },
        "proposerRef": {
          "type": "string",
          "minLength": 1
        },
        "bindingEvidence": {
          "type": "string",
          "minLength": 1
        },
        "ratificationAuthority": {
          "const": "director-only"
        }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "picks"],
      "properties": {
        "kind": {
          "enum": ["exclusive-multi-pick", "declared-incompatibility"]
        },
        "picks": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["a", "b", "c", "d"]
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionId",
        "raw",
        "normalizedPicks",
        "contradictions",
        "rationale",
        "eventId",
        "acknowledgedViewDigest"
      ],
      "properties": {
        "questionId": {
          "type": "string",
          "pattern": "^Q[1-6]$"
        },
        "raw": {
          "type": "string",
          "minLength": 1
        },
        "normalizedPicks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["a", "b", "c", "d"]
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contradiction"
          }
        },
        "rationale": {
          "type": ["string", "null"]
        },
        "eventId": {
          "type": "string",
          "minLength": 1
        },
        "acknowledgedViewDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "interpretations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round1",
        "round1Digest",
        "round2",
        "round2Digest",
        "axisMapping",
        "anchors"
      ],
      "properties": {
        "round1": {
          "$ref": "#/$defs/semanticRecord"
        },
        "round1Digest": {
          "$ref": "#/$defs/digest"
        },
        "round2": {
          "$ref": "#/$defs/semanticRecord"
        },
        "round2Digest": {
          "$ref": "#/$defs/digest"
        },
        "axisMapping": {
          "$ref": "#/$defs/semanticRecord"
        },
        "anchors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "evidenceRefs"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependencyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependencyId",
        "kind",
        "repository",
        "selector",
        "applicability",
        "snapshotDigest",
        "contributionRefs"
      ],
      "properties": {
        "dependencyId": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/semanticId"
        },
        "kind": {
          "enum": ["reference", "skill", "triangulation-process"]
        },
        "repository": {
          "type": ["string", "null"]
        },
        "selector": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path"],
              "properties": {
                "kind": {"const": "subdirectory"},
                "path": {
                  "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/relativePath"
                }
              }
            }
          ]
        },
        "applicability": {
          "enum": ["applicable", "not-applicable"]
        },
        "snapshotDigest": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/digest"}
          ]
        },
        "contributionRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stakeholderTimeCostMinutes",
        "comparisonBaseline",
        "notes"
      ],
      "properties": {
        "stakeholderTimeCostMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "comparisonBaseline": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ratification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "status", "eventId", "semanticDigest", "renderDigest"],
      "properties": {
        "authority": {
          "const": "director-only"
        },
        "status": {
          "enum": ["pending", "ratified"]
        },
        "eventId": {
          "type": ["string", "null"]
        },
        "semanticDigest": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/digest"}
          ]
        },
        "renderDigest": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/digest"}
          ]
        }
      }
    },
    "lifecycleHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "authorityRef", "planningInputRef"],
      "properties": {
        "from": {
          "const": "intent-open"
        },
        "to": {
          "const": "intent-captured"
        },
        "authorityRef": {
          "type": "string",
          "minLength": 1
        },
        "planningInputRef": {
          "const": "self"
        }
      }
    }
  }
}
