{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey-v2:schema:shared-schema-roots:v1",
  "title": "Survey v2 shared-schema root registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "source",
    "catalogPath",
    "roots"
  ],
  "properties": {
    "$schema": {
      "const": "urn:mission-kit:survey-v2:schema:shared-schema-roots:v1"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "const": "urn:mission-kit:survey-v2:shared-schema-roots"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repository",
        "selector"
      ],
      "properties": {
        "kind": {
          "const": "repository-selector"
        },
        "repository": {
          "const": "apnex/mission-kit"
        },
        "selector": {
          "const": "schemas"
        }
      }
    },
    "catalogPath": {
      "const": "catalog.json"
    },
    "roots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "kind",
              "schemaId",
              "semanticValidatorExport"
            ],
            "properties": {
              "kind": {
                "const": "ContextFrame"
              },
              "schemaId": {
                "const": "urn:mission-kit:schemas:context-frame:v1alpha1"
              },
              "semanticValidatorExport": {
                "const": "validateContextFrameSemantics"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "kind",
              "schemaId",
              "semanticValidatorExport"
            ],
            "properties": {
              "kind": {
                "const": "Question"
              },
              "schemaId": {
                "const": "urn:mission-kit:schemas:question:v1alpha1"
              },
              "semanticValidatorExport": {
                "const": "validateQuestionSemantics"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "kind",
          "schemaId",
          "semanticValidatorExport"
        ],
        "properties": {
          "apiVersion": {
            "const": "schemas.mission-kit/v1alpha1"
          },
          "kind": {
            "enum": [
              "ContextFrame",
              "Question"
            ]
          },
          "schemaId": {
            "type": "string",
            "pattern": "^urn:mission-kit:schemas:[a-z0-9:-]+:v1alpha1$"
          },
          "semanticValidatorExport": {
            "type": "string",
            "pattern": "^validate[A-Z][A-Za-z0-9]*Semantics$"
          }
        }
      }
    }
  }
}
