{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey-v2:schema:instrument:v1",
  "title": "Survey v2 frozen instrument",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "round", "revision", "questions", "orthogonalityRationale", "freezeDigest"],
  "properties": {
    "$schema": {
      "const": "urn:mission-kit:survey-v2:schema:instrument:v1"
    },
    "schemaVersion": {
      "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/schemaVersion"
    },
    "round": {
      "enum": [1, 2]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "questions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "orthogonalityRationale": {
      "type": "string",
      "minLength": 12
    },
    "boundRound1Digest": {
      "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/digest"
    },
    "freezeDigest": {
      "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/digest"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "round": {
            "const": 1
          }
        },
        "required": ["round"]
      },
      "then": {
        "type": "object",
        "not": {
          "type": "object",
          "properties": {
            "boundRound1Digest": true
          },
          "required": ["boundRound1Digest"]
        },
        "properties": {
          "questions": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              {
                "allOf": [
                  {"$ref": "#/$defs/question"},
                  {
                    "type": "object",
                    "properties": {"id": {"const": "Q1"}, "round": {"const": 1}},
                    "not": {
                      "properties": {"round1Relation": true},
                      "required": ["round1Relation"]
                    }
                  }
                ]
              },
              {
                "allOf": [
                  {"$ref": "#/$defs/question"},
                  {
                    "type": "object",
                    "properties": {"id": {"const": "Q2"}, "round": {"const": 1}},
                    "not": {
                      "properties": {"round1Relation": true},
                      "required": ["round1Relation"]
                    }
                  }
                ]
              },
              {
                "allOf": [
                  {"$ref": "#/$defs/question"},
                  {
                    "type": "object",
                    "properties": {"id": {"const": "Q3"}, "round": {"const": 1}},
                    "not": {
                      "properties": {"round1Relation": true},
                      "required": ["round1Relation"]
                    }
                  }
                ]
              }
            ],
            "items": false
          }
        }
      },
      "else": {
        "type": "object",
        "required": ["boundRound1Digest"],
        "properties": {
          "boundRound1Digest": true,
          "questions": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              {
                "allOf": [
                  {"$ref": "#/$defs/question"},
                  {
                    "type": "object",
                    "required": ["round1Relation"],
                    "properties": {
                      "id": {"const": "Q4"},
                      "round": {"const": 2},
                      "round1Relation": true
                    }
                  }
                ]
              },
              {
                "allOf": [
                  {"$ref": "#/$defs/question"},
                  {
                    "type": "object",
                    "required": ["round1Relation"],
                    "properties": {
                      "id": {"const": "Q5"},
                      "round": {"const": 2},
                      "round1Relation": true
                    }
                  }
                ]
              },
              {
                "allOf": [
                  {"$ref": "#/$defs/question"},
                  {
                    "type": "object",
                    "required": ["round1Relation"],
                    "properties": {
                      "id": {"const": "Q6"},
                      "round": {"const": 2},
                      "round1Relation": true
                    }
                  }
                ]
              }
            ],
            "items": false
          }
        }
      }
    }
  ],
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "meaning"],
      "properties": {
        "id": {
          "enum": ["a", "b", "c", "d"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "round", "intentDimension", "prompt", "options", "optionRelationship", "incompatibilities", "designRationale", "axisPreAnchors", "sourceEvidenceRefs"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q[1-6]$"
        },
        "round": {
          "enum": [1, 2]
        },
        "intentDimension": {
          "type": "string",
          "minLength": 3
        },
        "prompt": {
          "type": "string",
          "minLength": 8
        },
        "options": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/option"
          },
          "oneOf": [
            {
              "type": "array",
              "prefixItems": [
                {"allOf": [{"$ref": "#/$defs/option"}, {"type": "object", "properties": {"id": {"const": "a"}}}]},
                {"allOf": [{"$ref": "#/$defs/option"}, {"type": "object", "properties": {"id": {"const": "b"}}}]},
                {"allOf": [{"$ref": "#/$defs/option"}, {"type": "object", "properties": {"id": {"const": "c"}}}]}
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "array",
              "prefixItems": [
                {"allOf": [{"$ref": "#/$defs/option"}, {"type": "object", "properties": {"id": {"const": "a"}}}]},
                {"allOf": [{"$ref": "#/$defs/option"}, {"type": "object", "properties": {"id": {"const": "b"}}}]},
                {"allOf": [{"$ref": "#/$defs/option"}, {"type": "object", "properties": {"id": {"const": "c"}}}]},
                {"allOf": [{"$ref": "#/$defs/option"}, {"type": "object", "properties": {"id": {"const": "d"}}}]}
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4
            }
          ]
        },
        "optionRelationship": {
          "enum": ["composable", "exclusive", "mixed"]
        },
        "incompatibilities": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": ["a", "b", "c", "d"]
            }
          }
        },
        "designRationale": {
          "type": "string",
          "minLength": 8
        },
        "axisPreAnchors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "secondary"],
          "properties": {
            "primary": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "secondary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "round1Relation": {
          "enum": ["refines", "challenges", "disambiguates", "deepens"]
        },
        "sourceEvidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "optionRelationship": {
                "const": "mixed"
              }
            },
            "required": ["optionRelationship"]
          },
          "else": {
            "type": "object",
            "properties": {
              "incompatibilities": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "options": {
                "type": "array",
                "maxItems": 3
              }
            },
            "required": ["options"]
          },
          "then": {
            "type": "object",
            "properties": {
              "incompatibilities": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "enum": ["a", "b", "c"]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
