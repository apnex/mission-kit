{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey-v2:schema:protocol:v1",
  "title": "Survey v2 protocol manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "productInvariants", "machines", "rejectionRules", "quarantineOperation"],
  "properties": {
    "$schema": {
      "const": "urn:mission-kit:survey-v2:schema:protocol:v1"
    },
    "schemaVersion": {
      "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/semanticId"
    },
    "productInvariants": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/definition"
      }
    },
    "machines": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/machine"
      }
    },
    "rejectionRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/definition"
      }
    },
    "quarantineOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "schema"],
      "properties": {
        "id": {
          "const": "OQ01"
        },
        "description": {
          "type": "string",
          "minLength": 12
        },
        "schema": {
          "const": "urn:mission-kit:survey-v2:schema:quarantine:v1"
        }
      }
    }
  },
  "$defs": {
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "description": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "terminal"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "terminal": {
          "type": "boolean"
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "members"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S[GR][0-9]{2}$"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "event", "guard", "action", "mutation", "authority"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:T(?:0[1-9]|[1-4][0-9])|RT(?:0[1-9]|1[0-3]))$"
        },
        "from": {
          "type": "string",
          "pattern": "^(?:start|[a-z][a-z0-9_]*)$"
        },
        "to": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "event": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "guard": {
          "type": "string",
          "pattern": "^(?:G|RG)[A-Z0-9]+$"
        },
        "action": {
          "type": "string",
          "pattern": "^(?:A|RA)[A-Z0-9]+$"
        },
        "mutation": {
          "type": "string",
          "pattern": "^(?:M|RM)[A-Z0-9]+$"
        },
        "authority": {
          "type": "string",
          "pattern": "^AU0[1-5]$"
        },
        "coupledTransition": {
          "type": "string",
          "pattern": "^(?:T|TF|RT|RF)[A-Z0-9]+$"
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromSelector", "to", "event", "guard", "action", "mutation", "authority"],
      "properties": {
        "id": {
          "enum": ["TF01", "TF02", "RF01"]
        },
        "fromSelector": {
          "type": "string",
          "pattern": "^S[GR][0-9]{2}$"
        },
        "runtimeSelector": {
          "type": "string",
          "pattern": "^SR[0-9]{2}$"
        },
        "to": {
          "type": "string",
          "pattern": "^(?:same|[a-z][a-z0-9_]*)$"
        },
        "event": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "guard": {
          "type": "string",
          "pattern": "^(?:GF|RGF)[A-Z0-9]+$"
        },
        "action": {
          "type": "string",
          "pattern": "^(?:AF|RAF)[A-Z0-9]+$"
        },
        "mutation": {
          "type": "string",
          "pattern": "^(?:MF|RMF)[A-Z0-9]+$"
        },
        "authority": {
          "type": "string",
          "pattern": "^AU0[1-5]$"
        },
        "coupledFamily": {
          "type": "string",
          "pattern": "^(?:TF|RF)[0-9]{2}$"
        }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "initial", "states", "events", "guards", "actions", "mutations", "authorities", "selectors", "transitions", "families"],
      "properties": {
        "id": {
          "enum": ["phase", "runtime"]
        },
        "initial": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/state"
          }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/definition"
          }
        },
        "guards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/definition"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/definition"
          }
        },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/definition"
          }
        },
        "authorities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/definition"
          }
        },
        "selectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selector"
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/family"
          }
        }
      }
    }
  }
}
