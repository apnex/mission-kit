{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey-v2:schema:projection:v1",
  "title": "Survey v2 projection recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "renderer", "targets", "selection", "budget"],
  "properties": {
    "$schema": {
      "const": "urn:mission-kit:survey-v2:schema:projection:v1"
    },
    "schemaVersion": {
      "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/semanticId"
    },
    "renderer": {
      "enum": ["skill-md", "references", "diagrams", "executables", "agent-metadata", "validators", "indexes", "build-metadata", "assets"]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/relativePath"
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fragmentIds"],
      "properties": {
        "fragmentIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/semanticId"
          }
        },
        "sourcePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/relativePath"
          }
        },
        "headings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["heading", "fragmentIds"],
            "properties": {
              "target": {
                "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/relativePath"
              },
              "heading": {
                "type": "string",
                "minLength": 1
              },
              "fragmentIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/semanticId"
                }
              }
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxLines", "maxWords"],
      "properties": {
        "maxLines": {
          "type": "integer",
          "minimum": 1
        },
        "maxWords": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
