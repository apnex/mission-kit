{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey-v2:schema:shared-schema-closure:v1",
  "title": "Survey v2 sovereign shared-schema closure manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "source",
    "rootListDigest",
    "catalog",
    "resources",
    "schemas",
    "validators",
    "closureDigest"
  ],
  "properties": {
    "$schema": {
      "const": "urn:mission-kit:survey-v2:schema:shared-schema-closure:v1"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "const": "urn:mission-kit:survey-v2:shared-schema-closure"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repository",
        "selector"
      ],
      "properties": {
        "kind": {
          "const": "repository-selector"
        },
        "repository": {
          "const": "apnex/mission-kit"
        },
        "selector": {
          "const": "schemas"
        }
      }
    },
    "rootListDigest": {
      "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/digest"
    },
    "catalog": {
      "$ref": "#/$defs/jsonMember"
    },
    "resources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "apiVersion",
              "kind",
              "schemaId",
              "semanticValidatorExport"
            ],
            "properties": {
              "apiVersion": {
                "const": "schemas.mission-kit/v1alpha1"
              },
              "kind": {
                "const": "ContextFrame"
              },
              "schemaId": {
                "const": "urn:mission-kit:schemas:context-frame:v1alpha1"
              },
              "semanticValidatorExport": {
                "const": "validateContextFrameSemantics"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "apiVersion",
              "kind",
              "schemaId",
              "semanticValidatorExport"
            ],
            "properties": {
              "apiVersion": {
                "const": "schemas.mission-kit/v1alpha1"
              },
              "kind": {
                "const": "Question"
              },
              "schemaId": {
                "const": "urn:mission-kit:schemas:question:v1alpha1"
              },
              "semanticValidatorExport": {
                "const": "validateQuestionSemantics"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "$ref": "#/$defs/resourceBinding"
      }
    },
    "schemas": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/schemaMember"
      }
    },
    "validators": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/validatorMember"
      }
    },
    "closureDigest": {
      "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/digest"
    }
  },
  "$defs": {
    "apiVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kind": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{0,127}$"
    },
    "schemaId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "sourcePath": {
      "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/relativePath"
    },
    "snapshotPath": {
      "allOf": [
        {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/relativePath"
        },
        {
          "type": "string",
          "pattern": "^dependencies/shared-schemas/v1/snapshot/[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        }
      ]
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "mediaType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "jsonMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "snapshotPath",
        "bytes",
        "exactDigest",
        "semanticDigest",
        "mediaType"
      ],
      "properties": {
        "sourcePath": {
          "$ref": "#/$defs/sourcePath"
        },
        "snapshotPath": {
          "$ref": "#/$defs/snapshotPath"
        },
        "bytes": {
          "$ref": "#/$defs/bytes"
        },
        "exactDigest": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/digest"
        },
        "semanticDigest": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/digest"
        },
        "mediaType": {
          "const": "application/json"
        }
      }
    },
    "resourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "schemaId",
        "semanticValidatorPath",
        "semanticValidatorExport"
      ],
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "schemaId": {
          "$ref": "#/$defs/schemaId"
        },
        "semanticValidatorPath": {
          "$ref": "#/$defs/sourcePath"
        },
        "semanticValidatorExport": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        }
      }
    },
    "schemaMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourcePath",
        "snapshotPath",
        "bytes",
        "exactDigest",
        "semanticDigest",
        "mediaType",
        "memberRole",
        "refTargets"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/schemaId"
        },
        "sourcePath": {
          "$ref": "#/$defs/sourcePath"
        },
        "snapshotPath": {
          "$ref": "#/$defs/snapshotPath"
        },
        "bytes": {
          "$ref": "#/$defs/bytes"
        },
        "exactDigest": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/digest"
        },
        "semanticDigest": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/digest"
        },
        "mediaType": {
          "const": "application/schema+json"
        },
        "memberRole": {
          "enum": [
            "fragment",
            "resource"
          ]
        },
        "refTargets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/schemaId"
          }
        }
      }
    },
    "moduleImport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specifier",
        "sourcePath",
        "snapshotPath"
      ],
      "properties": {
        "specifier": {
          "type": "string",
          "pattern": "^\\.\\.?/[A-Za-z0-9._/-]+$"
        },
        "sourcePath": {
          "$ref": "#/$defs/sourcePath"
        },
        "snapshotPath": {
          "$ref": "#/$defs/snapshotPath"
        }
      }
    },
    "validatorMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "snapshotPath",
        "bytes",
        "exactDigest",
        "mediaType",
        "memberRole",
        "declaredExports",
        "staticImports",
        "resourceBindings"
      ],
      "properties": {
        "sourcePath": {
          "$ref": "#/$defs/sourcePath"
        },
        "snapshotPath": {
          "$ref": "#/$defs/snapshotPath"
        },
        "bytes": {
          "$ref": "#/$defs/bytes"
        },
        "exactDigest": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/digest"
        },
        "mediaType": {
          "const": "text/javascript"
        },
        "memberRole": {
          "enum": [
            "entry",
            "support"
          ]
        },
        "declaredExports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
          }
        },
        "staticImports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/moduleImport"
          }
        },
        "resourceBindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/resourceBinding"
          }
        }
      }
    }
  }
}
