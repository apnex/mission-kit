{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey-v2:schema:fragment:v1",
  "title": "Survey v2 one-purpose fragment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "revision",
    "purpose",
    "role",
    "normativity",
    "audiences",
    "representation",
    "rationale",
    "absenceConsequence",
    "composition",
    "requirements",
    "contribution",
    "exposure"
  ],
  "properties": {
    "$schema": {
      "const": "urn:mission-kit:survey-v2:schema:fragment:v1"
    },
    "schemaVersion": {
      "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/semanticId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 12,
      "pattern": "[.!?]$"
    },
    "role": {
      "enum": ["definition", "constraint", "procedure", "decision-table", "navigation", "template", "view", "example", "executable"]
    },
    "normativity": {
      "enum": ["normative", "supporting", "illustrative"]
    },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["agent", "Director", "maintainer", "downstream-designer"]
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "payloadPath", "mediaType"],
      "properties": {
        "format": {
          "enum": ["markdown", "json", "mermaid", "text", "template", "javascript", "shell"]
        },
        "payloadPath": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/relativePath"
        },
        "mediaType": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 12
    },
    "absenceConsequence": {
      "type": "string",
      "minLength": 12
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provides", "requires", "dependencies"],
      "properties": {
        "provides": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]+@1$"
          }
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]+@1$"
          }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/semanticId"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^R(?:0[1-9]|1[0-9]|2[0-8])$"
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "proofClass", "obligations"],
      "properties": {
        "mode": {
          "enum": ["unique", "supporting"]
        },
        "proofClass": {
          "enum": ["sole-required-provider", "required-coverage", "transition-coverage", "negative-case-coverage", "cold-resume-coverage", "context-budget", "navigation-hop-budget"]
        },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^O-R(?:0[1-9]|1[0-9]|2[0-8])-[0-9]{2}$"
          }
        }
      }
    },
    "exposure": {
      "enum": ["internal", "exported"]
    }
  }
}
