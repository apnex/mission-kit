{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey-v2:schema:package:v1",
  "title": "Survey v2 sovereign package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "name",
    "publicSkillName",
    "version",
    "parentDesignSha256",
    "schemas",
    "sharedSchemaClosure",
    "members",
    "projections",
    "requirementsRegistry",
    "testEvidenceManifest"
  ],
  "properties": {
    "$schema": {
      "const": "urn:mission-kit:survey-v2:schema:package:v1"
    },
    "schemaVersion": {
      "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/semanticId"
    },
    "name": {
      "const": "survey-v2"
    },
    "publicSkillName": {
      "const": "survey"
    },
    "version": {
      "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/schemaVersion"
    },
    "parentDesignSha256": {
      "const": "6467fff1c74c6dc857bcb06722d19dfa04381ae3e6f242eccb36581f87560f74"
    },
    "schemas": {
      "type": "array",
      "minItems": 17,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^urn:mission-kit:survey-v2:schema:[a-z0-9-]+:v1$"
              },
              {
                "type": "string",
                "pattern": "^urn:mission-kit:authoring:schema:[a-z0-9-]+:v1alpha1$"
              },
              {
                "type": "string",
                "pattern": "^urn:mission-kit:survey:schema:[a-z0-9-]+:v1alpha1$"
              },
              {
                "type": "string",
                "pattern": "^urn:mission-kit:survey-v2:schema:[a-z0-9-]+:v2$"
              }
            ]
          },
          "path": {
            "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/relativePath"
          }
        }
      }
    },
    "sharedSchemaClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roots",
        "manifest"
      ],
      "properties": {
        "roots": {
          "const": "dependencies/shared-schemas/v1/roots.json"
        },
        "manifest": {
          "const": "dependencies/shared-schemas/v1/closure.manifest.json"
        }
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind"],
        "properties": {
          "path": {
            "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/relativePath"
          },
          "kind": {
            "enum": [
              "authored",
              "generated",
              "bootstrap",
              "supply-lock",
              "dependency-snapshot"
            ]
          },
          "expectedId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "projections": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/relativePath"
      }
    },
    "requirementsRegistry": {
      "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/relativePath"
    },
    "testEvidenceManifest": {
      "$ref": "urn:mission-kit:survey-v2:schema:common:v1#/$defs/relativePath"
    }
  }
}
