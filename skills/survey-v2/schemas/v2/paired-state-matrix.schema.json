{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey-v2:schema:paired-state-matrix:v2",
  "title": "Survey v2 canonical authoring and phase paired-state matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "protocol",
    "authoringProtocol",
    "pairs"
  ],
  "properties": {
    "$schema": {
      "const": "urn:mission-kit:survey-v2:schema:paired-state-matrix:v2"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "id": {
      "const": "urn:mission-kit:survey-v2:paired-state-matrix:survey-v2"
    },
    "protocol": {
      "$ref": "#/$defs/protocolBinding"
    },
    "authoringProtocol": {
      "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
    },
    "pairs": {
      "type": "array",
      "minItems": 38,
      "maxItems": 38,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pair"
      }
    }
  },
  "$defs": {
    "protocolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schemaVersion",
        "sourceBytesDigest"
      ],
      "properties": {
        "id": {
          "const": "urn:mission-kit:survey-v2:protocol:survey"
        },
        "schemaVersion": {
          "const": "2.0.0"
        },
        "sourceBytesDigest": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v2#/$defs/digest"
        }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoringState",
        "phaseState",
        "pathClasses"
      ],
      "properties": {
        "authoringState": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v2#/$defs/authoringStateId"
        },
        "phaseState": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v2#/$defs/phaseStateId"
        },
        "pathClasses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:mission-kit:survey-v2:schema:common:v2#/$defs/pathClass"
          }
        }
      }
    }
  }
}
