{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey-v2:schema:director-projection-recipe:v1",
  "title": "Survey v2 internal Director projection recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "viewKind",
    "recipeDigest",
    "instrument",
    "generationContext",
    "unit",
    "sourceSelections",
    "projection"
  ],
  "properties": {
    "$schema": {
      "const": "urn:mission-kit:survey-v2:schema:director-projection-recipe:v1"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "viewKind": {
      "const": "question"
    },
    "recipeDigest": {
      "$ref": "#/$defs/digest"
    },
    "instrument": {
      "$ref": "#/$defs/storedAuthority"
    },
    "generationContext": {
      "$ref": "#/$defs/storedAuthority"
    },
    "unit": {
      "$ref": "#/$defs/unit"
    },
    "sourceSelections": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/surveyFrameSelection"
        },
        {
          "$ref": "#/$defs/roundFrameSelection"
        },
        {
          "$ref": "#/$defs/questionFrameSelection"
        },
        {
          "$ref": "#/$defs/questionSelection"
        }
      ],
      "items": false
    },
    "projection": {
      "$ref": "#/$defs/projectionAuthority"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "name",
        "semanticDigest"
      ],
      "properties": {
        "apiVersion": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "semanticDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "storedAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "integrityDigest"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "integrityDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "questionOrdinal",
        "questionFrameRef",
        "bindingRef",
        "questionRef"
      ],
      "properties": {
        "slot": {
          "const": 1
        },
        "questionOrdinal": {
          "const": 1
        },
        "questionFrameRef": {
          "$ref": "#/$defs/reference"
        },
        "bindingRef": {
          "$ref": "#/$defs/reference"
        },
        "questionRef": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "selectedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "value"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "value": true
      }
    },
    "sourceSelectionBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "role",
        "sourceReference",
        "sourceIntegrityDigest",
        "selectedValues"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "sourceReference": {
          "$ref": "#/$defs/reference"
        },
        "sourceIntegrityDigest": {
          "$ref": "#/$defs/digest"
        },
        "selectedValues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/selectedValue"
          }
        }
      }
    },
    "surveyFrameSelection": {
      "allOf": [
        {
          "$ref": "#/$defs/sourceSelectionBase"
        },
        {
          "type": "object",
          "properties": {
            "ordinal": {
              "const": 1
            },
            "role": {
              "const": "survey-frame"
            },
            "selectedValues": {
              "$ref": "#/$defs/synopsisSelection"
            }
          }
        }
      ]
    },
    "roundFrameSelection": {
      "allOf": [
        {
          "$ref": "#/$defs/sourceSelectionBase"
        },
        {
          "type": "object",
          "properties": {
            "ordinal": {
              "const": 2
            },
            "role": {
              "const": "round-frame"
            },
            "selectedValues": {
              "$ref": "#/$defs/synopsisSelection"
            }
          }
        }
      ]
    },
    "questionFrameSelection": {
      "allOf": [
        {
          "$ref": "#/$defs/sourceSelectionBase"
        },
        {
          "type": "object",
          "properties": {
            "ordinal": {
              "const": 3
            },
            "role": {
              "const": "question-frame"
            },
            "selectedValues": {
              "$ref": "#/$defs/synopsisSelection"
            }
          }
        }
      ]
    },
    "synopsisSelection": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "value"
          ],
          "properties": {
            "path": {
              "const": "/spec/synopsis"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ],
      "items": false
    },
    "questionSelection": {
      "allOf": [
        {
          "$ref": "#/$defs/sourceSelectionBase"
        },
        {
          "type": "object",
          "properties": {
            "ordinal": {
              "const": 4
            },
            "role": {
              "const": "question"
            },
            "selectedValues": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "value"
                  ],
                  "properties": {
                    "path": {
                      "const": "/spec/prompt"
                    },
                    "value": {
                      "$ref": "#/$defs/prompt"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "value"
                  ],
                  "properties": {
                    "path": {
                      "const": "/spec/response/options"
                    },
                    "value": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 4,
                      "items": {
                        "$ref": "#/$defs/option"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "value"
                  ],
                  "properties": {
                    "path": {
                      "const": "/spec/response/cardinality"
                    },
                    "value": {
                      "$ref": "#/$defs/cardinality"
                    }
                  }
                }
              ],
              "items": false
            }
          }
        }
      ]
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "meaning"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-d]$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "cardinality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "projectionAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "engine",
        "outputSchema"
      ],
      "properties": {
        "definition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "digest"
          ],
          "properties": {
            "id": {
              "const": "survey.director.current-question/v1"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "executableClosureDigest"
          ],
          "properties": {
            "id": {
              "const": "survey.director.current-question-renderer/v1"
            },
            "executableClosureDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "sourceDigest"
          ],
          "properties": {
            "id": {
              "const": "urn:mission-kit:survey-v2:schema:question-presentation:v2"
            },
            "sourceDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      }
    }
  }
}
