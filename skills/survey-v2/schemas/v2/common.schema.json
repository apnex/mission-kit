{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey-v2:schema:common:v2",
  "title": "Survey v2 candidate common definitions",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "semanticId": {
      "type": "string",
      "pattern": "^urn:mission-kit:survey-v2:[a-z0-9][a-z0-9:-]*$"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "phaseStateId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "authoringStateId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "runtimeStateId": {
      "type": "string",
      "pattern": "^(?:start|[a-z][a-z0-9_]*)$"
    },
    "pathClass": {
      "enum": [
        "mainline",
        "correction",
        "abort",
        "terminal"
      ]
    }
  }
}
