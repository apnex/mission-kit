{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey-v2:schema:protocol-selection:v2",
  "title": "Survey protocol candidate-selection contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "defaultSelection",
    "candidateSelections",
    "historicalCompatibility"
  ],
  "properties": {
    "$schema": {
      "const": "urn:mission-kit:survey-v2:schema:protocol-selection:v2"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "id": {
      "const": "urn:mission-kit:survey-v2:protocol-selection:survey"
    },
    "defaultSelection": {
      "$ref": "#/$defs/activeDefault"
    },
    "candidateSelections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/explicitCandidate"
      }
    },
    "historicalCompatibility": {
      "$ref": "#/$defs/historicalCompatibility"
    }
  },
  "$defs": {
    "activePackageBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "projectionLockPath",
        "rootClass"
      ],
      "properties": {
        "id": {
          "const": "urn:mission-kit:survey-v2:package:survey-v2"
        },
        "version": {
          "const": "2.0.0"
        },
        "projectionLockPath": {
          "const": "generated/projection-lock.json"
        },
        "rootClass": {
          "const": "active-package-root"
        }
      }
    },
    "frozenPackageBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "projectionDigest"
      ],
      "properties": {
        "id": {
          "const": "urn:mission-kit:survey-v2:package:survey-v2"
        },
        "version": {
          "const": "1.0.0"
        },
        "projectionDigest": {
          "const": "sha256:6603b777b82783176fca6129bfecde7a6e253f5be86f9becf94703d818b9757c"
        }
      }
    },
    "protocolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "schema",
        "sourcePath",
        "sourceBytesDigest"
      ],
      "properties": {
        "id": {
          "const": "urn:mission-kit:survey-v2:protocol:survey"
        },
        "version": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v2#/$defs/schemaVersion"
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "sourcePath": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v2#/$defs/relativePath"
        },
        "sourceBytesDigest": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v2#/$defs/digest"
        }
      }
    },
    "activeExecutionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "implementationStatus",
        "quarantineSchema"
      ],
      "properties": {
        "executor": {
          "const": "current-package"
        },
        "implementationStatus": {
          "const": "available"
        },
        "quarantineSchema": {
          "const": "urn:mission-kit:survey-v2:schema:quarantine:v2"
        }
      }
    },
    "candidateExecutionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "implementationStatus",
        "quarantineSchema"
      ],
      "properties": {
        "executor": {
          "const": "current-package"
        },
        "implementationStatus": {
          "const": "contract-only"
        },
        "quarantineSchema": {
          "const": "urn:mission-kit:survey-v2:schema:quarantine:v2"
        }
      }
    },
    "historicalExecutionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "implementationStatus",
        "quarantineSchema"
      ],
      "properties": {
        "executor": {
          "const": "matching-frozen-package"
        },
        "implementationStatus": {
          "const": "matching-package-required"
        },
        "quarantineSchema": {
          "const": "urn:mission-kit:survey-v2:schema:quarantine:v1"
        }
      }
    },
    "activeDefault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "activation",
        "status",
        "package",
        "protocol",
        "sessionSchema",
        "execution"
      ],
      "properties": {
        "id": {
          "const": "active-v1-default"
        },
        "activation": {
          "const": "implicit"
        },
        "status": {
          "const": "active"
        },
        "package": {
          "$ref": "#/$defs/activePackageBinding"
        },
        "protocol": {
          "$ref": "#/$defs/protocolBinding"
        },
        "sessionSchema": {
          "const": "urn:mission-kit:survey-v2:schema:session-state-active-v1:v2"
        },
        "execution": {
          "$ref": "#/$defs/activeExecutionBinding"
        }
      }
    },
    "explicitCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "activation",
        "status",
        "package",
        "protocol",
        "sessionSchema",
        "execution"
      ],
      "properties": {
        "id": {
          "const": "v2-authoring-candidate"
        },
        "activation": {
          "const": "explicit"
        },
        "status": {
          "const": "candidate"
        },
        "package": {
          "$ref": "#/$defs/activePackageBinding"
        },
        "protocol": {
          "$ref": "#/$defs/protocolBinding"
        },
        "sessionSchema": {
          "const": "urn:mission-kit:survey-v2:schema:session-state:v2"
        },
        "execution": {
          "$ref": "#/$defs/candidateExecutionBinding"
        }
      }
    },
    "historicalCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "activation",
        "status",
        "package",
        "protocol",
        "sessionSchema",
        "execution"
      ],
      "properties": {
        "id": {
          "const": "historical-v1-resume"
        },
        "activation": {
          "const": "resume-only"
        },
        "status": {
          "const": "frozen"
        },
        "package": {
          "$ref": "#/$defs/frozenPackageBinding"
        },
        "protocol": {
          "$ref": "#/$defs/protocolBinding"
        },
        "sessionSchema": {
          "const": "urn:mission-kit:survey-v2:schema:session-state:v1"
        },
        "execution": {
          "$ref": "#/$defs/historicalExecutionBinding"
        }
      }
    }
  }
}
