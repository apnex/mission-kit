{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey-v2:schema:protocol:v2",
  "title": "Survey v2 candidate protocol manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "productInvariants",
    "machines",
    "authoringCouplings",
    "atomicSequences",
    "rejectionRules",
    "quarantineOperation"
  ],
  "properties": {
    "$schema": {
      "const": "urn:mission-kit:survey-v2:schema:protocol:v2"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "id": {
      "const": "urn:mission-kit:survey-v2:protocol:survey"
    },
    "productInvariants": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/definition"
      }
    },
    "machines": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/authoringMachine"
        },
        {
          "$ref": "#/$defs/phaseMachine"
        },
        {
          "$ref": "#/$defs/runtimeMachine"
        }
      ],
      "items": false
    },
    "authoringCouplings": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/authoringCoupling"
      }
    },
    "atomicSequences": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/atomicSequence"
      }
    },
    "rejectionRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/definition"
      }
    },
    "quarantineOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "schema"
      ],
      "properties": {
        "id": {
          "const": "OQ01"
        },
        "description": {
          "type": "string",
          "minLength": 12
        },
        "schema": {
          "const": "urn:mission-kit:survey-v2:schema:quarantine:v2"
        }
      }
    }
  },
  "$defs": {
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "description": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "terminal"
      ],
      "properties": {
        "id": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v2#/$defs/phaseStateId"
        },
        "label": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "terminal": {
          "type": "boolean"
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "members"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S[GR][0-9]{2}$"
        },
        "label": {
          "type": "string",
          "minLength": 8,
          "maxLength": 80
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:mission-kit:survey-v2:schema:common:v2#/$defs/phaseStateId"
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "event",
        "guard",
        "action",
        "mutation",
        "authority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:T(?:0[1-9]|[1-3][0-9]|4[017])|RT(?:0[1-9]|1[0-3]))$"
        },
        "from": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v2#/$defs/runtimeStateId"
        },
        "to": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v2#/$defs/phaseStateId"
        },
        "event": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "guard": {
          "type": "string",
          "pattern": "^(?:G|RG)[A-Z0-9]+$"
        },
        "action": {
          "type": "string",
          "pattern": "^(?:A|RA)[A-Z0-9]+$"
        },
        "mutation": {
          "type": "string",
          "pattern": "^(?:M|RM)[A-Z0-9]+$"
        },
        "authority": {
          "type": "string",
          "pattern": "^AU0[1-5]$"
        },
        "coupledTransition": {
          "type": "string",
          "pattern": "^(?:T|TF|RT|RF)[A-Z0-9]+$"
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fromSelector",
        "to",
        "event",
        "guard",
        "action",
        "mutation",
        "authority"
      ],
      "properties": {
        "id": {
          "enum": [
            "TF01",
            "TF02",
            "RF01"
          ]
        },
        "fromSelector": {
          "type": "string",
          "pattern": "^S[GR][0-9]{2}$"
        },
        "runtimeSelector": {
          "type": "string",
          "pattern": "^SR[0-9]{2}$"
        },
        "to": {
          "type": "string",
          "pattern": "^(?:same|[a-z][a-z0-9_]*)$"
        },
        "event": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "guard": {
          "type": "string",
          "pattern": "^(?:GF|RGF)[A-Z0-9]+$"
        },
        "action": {
          "type": "string",
          "pattern": "^(?:AF|RAF)[A-Z0-9]+$"
        },
        "mutation": {
          "type": "string",
          "pattern": "^(?:MF|RMF)[A-Z0-9]+$"
        },
        "authority": {
          "type": "string",
          "pattern": "^AU0[1-5]$"
        },
        "coupledFamily": {
          "type": "string",
          "pattern": "^(?:TF|RF)[0-9]{2}$"
        }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "initial",
        "states",
        "events",
        "guards",
        "actions",
        "mutations",
        "authorities",
        "selectors",
        "transitions",
        "families"
      ],
      "properties": {
        "id": {
          "enum": [
            "phase",
            "runtime"
          ]
        },
        "initial": {
          "$ref": "urn:mission-kit:survey-v2:schema:common:v2#/$defs/phaseStateId"
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/state"
          }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/definition"
          }
        },
        "guards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/definition"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/definition"
          }
        },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/definition"
          }
        },
        "authorities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/definition"
          }
        },
        "selectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selector"
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/family"
          }
        }
      }
    },
    "authoringMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reference",
        "protocol"
      ],
      "properties": {
        "id": {
          "const": "authoring"
        },
        "reference": {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        "protocol": {
          "$ref": "urn:mission-kit:authoring:schema:authoring-protocol:v1alpha1"
        }
      }
    },
    "phaseMachine": {
      "allOf": [
        {
          "$ref": "#/$defs/machine"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "phase"
            }
          }
        }
      ]
    },
    "runtimeMachine": {
      "allOf": [
        {
          "$ref": "#/$defs/machine"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "runtime"
            }
          }
        }
      ]
    },
    "authoringCoupling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phaseTransitionId",
        "authoringTransitionId",
        "atomic"
      ],
      "properties": {
        "phaseTransitionId": {
          "type": "string",
          "pattern": "^(?:T(?:0[1-9]|[1-3][0-9]|4[017])|TF01)$"
        },
        "authoringTransitionId": {
          "type": "string",
          "pattern": "^(?:AT(?:0[1-9]|1[0-6])|AC0[1-5]|AF01)$"
        },
        "atomic": {
          "const": true
        }
      }
    },
    "atomicSequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "edges",
        "atomic"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{2,15}$"
        },
        "description": {
          "type": "string",
          "minLength": 12,
          "maxLength": 240
        },
        "edges": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "machineId",
              "transitionId"
            ],
            "properties": {
              "machineId": {
                "enum": [
                  "authoring",
                  "phase",
                  "runtime"
                ]
              },
              "transitionId": {
                "type": "string",
                "pattern": "^(?:AT|AC|AF|T|TF|RT|RF)[A-Z0-9]+$"
              }
            }
          }
        },
        "atomic": {
          "const": true
        }
      }
    }
  }
}
