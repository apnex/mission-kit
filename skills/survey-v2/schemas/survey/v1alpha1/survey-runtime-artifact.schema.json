{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey:schema:survey-runtime-artifact:v1alpha1",
  "title": "Mission Kit SurveyRuntimeArtifact resource v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "survey.mission-kit/v1alpha1"
    },
    "kind": {
      "const": "SurveyRuntimeArtifact"
    },
    "metadata": {
      "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/metadata"
    },
    "spec": {
      "oneOf": [
        {
          "$ref": "#/$defs/roundResponseSet"
        },
        {
          "$ref": "#/$defs/revisionDirective"
        },
        {
          "$ref": "#/$defs/candidateValidationEvidence"
        },
        {
          "$ref": "#/$defs/finalizationDiagnostic"
        },
        {
          "$ref": "#/$defs/compositeRuntimeEvidence"
        }
      ]
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surveyRunId",
        "sourcePhaseTransitionId",
        "sourceEventId",
        "sourceSemanticRevision",
        "sourceDigest"
      ],
      "properties": {
        "surveyRunId": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/runId"
        },
        "sourcePhaseTransitionId": {
          "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/transitionId"
        },
        "sourceEventId": {
          "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/eventId"
        },
        "sourceSemanticRevision": {
          "type": "integer",
          "minimum": 0
        },
        "sourceDigest": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/digest"
        }
      }
    },
    "variantBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "source",
        "payload"
      ]
    },
    "roundResponseSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "source",
        "payload"
      ],
      "properties": {
        "artifactType": {
          "const": "RoundResponseSet"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "payload": {
          "$ref": "#/$defs/roundResponseSetPayload"
        }
      }
    },
    "roundResponseSetPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roundRef",
        "roundOrdinal",
        "instrumentRef",
        "responses"
      ],
      "properties": {
        "roundRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/SurveyRoundReference"
        },
        "roundOrdinal": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/roundOrdinal"
        },
        "instrumentRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/RoundInstrumentReference"
        },
        "responses": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/response"
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "questionOrdinal",
        "questionRef",
        "bindingRef",
        "rawEvidence",
        "normalizedPicks",
        "acknowledgedViewDigest"
      ],
      "properties": {
        "slot": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/roundSlot"
        },
        "questionOrdinal": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/questionOrdinal"
        },
        "questionRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/QuestionReference"
        },
        "bindingRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/SurveyQuestionBindingReference"
        },
        "rawEvidence": {
          "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/ExactBytes"
        },
        "normalizedPicks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/optionId"
          }
        },
        "acknowledgedViewDigest": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/digest"
        }
      }
    },
    "revisionDirective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "source",
        "payload"
      ],
      "properties": {
        "artifactType": {
          "const": "RevisionDirective"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "payload": {
          "$ref": "#/$defs/revisionDirectivePayload"
        }
      }
    },
    "revisionDirectivePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "targetRef",
        "directiveText",
        "directorEvidenceDigest"
      ],
      "properties": {
        "target": {
          "enum": [
            "composite",
            "round-2-interpretation"
          ]
        },
        "targetRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/resourceReference"
        },
        "directiveText": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/boundedText"
        },
        "directorEvidenceDigest": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/digest"
        }
      }
    },
    "candidateValidationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "source",
        "payload"
      ],
      "properties": {
        "artifactType": {
          "const": "CandidateValidationEvidence"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "payload": {
          "$ref": "#/$defs/candidateValidationEvidencePayload"
        }
      }
    },
    "candidateValidationEvidencePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateRef",
        "validatorBindings",
        "issues"
      ],
      "properties": {
        "candidateRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/resourceReference"
        },
        "validatorBindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DigestBinding"
          }
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/issue"
          }
        }
      }
    },
    "finalizationDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "source",
        "payload"
      ],
      "properties": {
        "artifactType": {
          "const": "FinalizationDiagnostic"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "payload": {
          "$ref": "#/$defs/finalizationDiagnosticPayload"
        }
      }
    },
    "finalizationDiagnosticPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "candidateRef",
        "attemptDigest",
        "issues"
      ],
      "properties": {
        "target": {
          "enum": [
            "composite",
            "round-2-interpretation"
          ]
        },
        "candidateRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/resourceReference"
        },
        "attemptDigest": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/digest"
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/issue"
          }
        }
      }
    },
    "compositeRuntimeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "source",
        "payload"
      ],
      "properties": {
        "artifactType": {
          "const": "CompositeRuntimeEvidence"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "payload": {
          "$ref": "#/$defs/compositeRuntimeEvidencePayload"
        }
      }
    },
    "compositeRuntimeEvidencePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodologyRefs",
        "authorityRefs",
        "dependencyRefs",
        "runtimeRefs"
      ],
      "properties": {
        "methodologyRefs": {
          "$ref": "#/$defs/referenceSet"
        },
        "authorityRefs": {
          "$ref": "#/$defs/referenceSet"
        },
        "dependencyRefs": {
          "$ref": "#/$defs/referenceSet"
        },
        "runtimeRefs": {
          "$ref": "#/$defs/referenceSet"
        }
      }
    },
    "referenceSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/resourceReference"
      }
    }
  }
}
