{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey:schema:round-interpretation:v1alpha1",
  "title": "Mission Kit RoundInterpretation resource v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "survey.mission-kit/v1alpha1"
    },
    "kind": {
      "const": "RoundInterpretation"
    },
    "metadata": {
      "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roundRef",
        "roundOrdinal",
        "instrumentRef",
        "responseSetRef",
        "generationContextRef",
        "perQuestion",
        "aggregateMeaning",
        "tensions",
        "axisMapping"
      ],
      "properties": {
        "roundRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/SurveyRoundReference"
        },
        "roundOrdinal": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/roundOrdinal"
        },
        "instrumentRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/RoundInstrumentReference"
        },
        "responseSetRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/SurveyRuntimeArtifactReference"
        },
        "generationContextRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/ContextClosureReference"
        },
        "priorRoundInterpretationRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/RoundInterpretationReference"
        },
        "perQuestion": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/questionInterpretation"
          }
        },
        "aggregateMeaning": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/boundedText"
        },
        "tensions": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/boundedText"
          }
        },
        "axisMapping": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/axisMapping"
          }
        }
      }
    }
  },
  "$defs": {
    "questionInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionOrdinal",
        "questionRef",
        "meaning",
        "evidenceRefs",
        "axisMappings",
        "tensions"
      ],
      "properties": {
        "questionOrdinal": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/questionOrdinal"
        },
        "questionRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/QuestionReference"
        },
        "meaning": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/boundedText"
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/resourceReference"
          }
        },
        "axisMappings": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/axisMapping"
          }
        },
        "tensions": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/boundedText"
          }
        }
      }
    }
  }
}
