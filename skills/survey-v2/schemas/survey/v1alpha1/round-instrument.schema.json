{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey:schema:round-instrument:v1alpha1",
  "title": "Mission Kit RoundInstrument resource v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "survey.mission-kit/v1alpha1"
    },
    "kind": {
      "const": "RoundInstrument"
    },
    "metadata": {
      "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roundRef",
        "roundOrdinal",
        "frameSetRef",
        "policySnapshotRef",
        "generationContextRef",
        "units",
        "responsePolicy"
      ],
      "properties": {
        "roundRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/SurveyRoundReference"
        },
        "roundOrdinal": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/roundOrdinal"
        },
        "frameSetRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/QuestionFrameSetReference"
        },
        "policySnapshotRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/SurveyPolicySnapshotReference"
        },
        "generationContextRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/ContextClosureReference"
        },
        "units": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/instrumentUnit"
          }
        },
        "responsePolicy": {
          "$ref": "#/$defs/responsePolicy"
        }
      }
    }
  },
  "$defs": {
    "instrumentUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "questionOrdinal",
        "questionFrameRef",
        "bindingRef",
        "questionRef"
      ],
      "properties": {
        "slot": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/roundSlot"
        },
        "questionOrdinal": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/questionOrdinal"
        },
        "questionFrameRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/ContextFrameReference"
        },
        "bindingRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/SurveyQuestionBindingReference"
        },
        "questionRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/QuestionReference"
        }
      }
    },
    "responsePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture",
        "rawEvidence",
        "duplicateSubmission",
        "invalidSyntax",
        "unknownOption",
        "cardinalityViolation",
        "declaredConstraintViolation"
      ],
      "properties": {
        "capture": {
          "const": "option-id-list"
        },
        "rawEvidence": {
          "const": "preserved"
        },
        "duplicateSubmission": {
          "const": "idempotent"
        },
        "invalidSyntax": {
          "const": "reject-without-advance"
        },
        "unknownOption": {
          "const": "reject-without-advance"
        },
        "cardinalityViolation": {
          "const": "reject-without-advance"
        },
        "declaredConstraintViolation": {
          "const": "preserve-as-contradiction"
        }
      }
    }
  }
}
