{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey:schema:common:v1alpha1",
  "title": "Mission Kit Survey authoring common definitions v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "metadata": {
      "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/metadata"
    },
    "digest": {
      "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/digest"
    },
    "semanticId": {
      "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/semanticId"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "roundOrdinal": {
      "enum": [
        1,
        2
      ]
    },
    "roundSlot": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "questionOrdinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "scopeRelation": {
      "enum": [
        "narrows",
        "partitions",
        "qualifies"
      ]
    },
    "roundOneRelation": {
      "enum": [
        "refines",
        "challenges",
        "disambiguates",
        "deepens"
      ]
    },
    "optionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[-a-z0-9._:]*[a-z0-9])?$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "resourceReference": {
      "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
    },
    "SurveyReference": {
      "allOf": [
        {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        {
          "type": "object",
          "properties": {
            "apiVersion": {
              "const": "survey.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "Survey"
            }
          }
        }
      ]
    },
    "SurveyRoundReference": {
      "allOf": [
        {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        {
          "type": "object",
          "properties": {
            "apiVersion": {
              "const": "survey.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "SurveyRound"
            }
          }
        }
      ]
    },
    "QuestionFrameSetReference": {
      "allOf": [
        {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        {
          "type": "object",
          "properties": {
            "apiVersion": {
              "const": "survey.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "QuestionFrameSet"
            }
          }
        }
      ]
    },
    "SurveyQuestionBindingReference": {
      "allOf": [
        {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        {
          "type": "object",
          "properties": {
            "apiVersion": {
              "const": "survey.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "SurveyQuestionBinding"
            }
          }
        }
      ]
    },
    "RoundInstrumentReference": {
      "allOf": [
        {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        {
          "type": "object",
          "properties": {
            "apiVersion": {
              "const": "survey.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "RoundInstrument"
            }
          }
        }
      ]
    },
    "RoundInterpretationReference": {
      "allOf": [
        {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        {
          "type": "object",
          "properties": {
            "apiVersion": {
              "const": "survey.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "RoundInterpretation"
            }
          }
        }
      ]
    },
    "SurveyPolicySnapshotReference": {
      "allOf": [
        {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        {
          "type": "object",
          "properties": {
            "apiVersion": {
              "const": "survey.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "SurveyPolicySnapshot"
            }
          }
        }
      ]
    },
    "SurveyRuntimeArtifactReference": {
      "allOf": [
        {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        {
          "type": "object",
          "properties": {
            "apiVersion": {
              "const": "survey.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "SurveyRuntimeArtifact"
            }
          }
        }
      ]
    },
    "GenerationRecordReference": {
      "allOf": [
        {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        {
          "type": "object",
          "properties": {
            "apiVersion": {
              "const": "survey.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "GenerationRecord"
            }
          }
        }
      ]
    },
    "ContextFrameReference": {
      "allOf": [
        {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        {
          "type": "object",
          "properties": {
            "apiVersion": {
              "const": "schemas.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "ContextFrame"
            }
          }
        }
      ]
    },
    "QuestionReference": {
      "allOf": [
        {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        {
          "type": "object",
          "properties": {
            "apiVersion": {
              "const": "schemas.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "Question"
            }
          }
        }
      ]
    },
    "AuthoringProfileManifestReference": {
      "allOf": [
        {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        {
          "type": "object",
          "properties": {
            "apiVersion": {
              "const": "authoring.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "AuthoringProfileManifest"
            }
          }
        }
      ]
    },
    "AuthoringRequestReference": {
      "allOf": [
        {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        {
          "type": "object",
          "properties": {
            "apiVersion": {
              "const": "authoring.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "AuthoringRequest"
            }
          }
        }
      ]
    },
    "AuthoringAssignmentReference": {
      "allOf": [
        {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        {
          "type": "object",
          "properties": {
            "apiVersion": {
              "const": "authoring.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "AuthoringAssignment"
            }
          }
        }
      ]
    },
    "AuthoringSubmissionReference": {
      "allOf": [
        {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        {
          "type": "object",
          "properties": {
            "apiVersion": {
              "const": "authoring.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "AuthoringSubmission"
            }
          }
        }
      ]
    },
    "ContextClosureReference": {
      "allOf": [
        {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        {
          "type": "object",
          "properties": {
            "apiVersion": {
              "const": "authoring.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "ContextClosure"
            }
          }
        }
      ]
    },
    "AuthoringCommitReceiptReference": {
      "allOf": [
        {
          "$ref": "urn:mission-kit:authoring:schema:resource-reference:v1alpha1"
        },
        {
          "type": "object",
          "properties": {
            "apiVersion": {
              "const": "authoring.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "AuthoringCommitReceipt"
            }
          }
        }
      ]
    },
    "axisAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "anchor"
      ],
      "properties": {
        "axis": {
          "$ref": "#/$defs/shortText"
        },
        "anchor": {
          "$ref": "#/$defs/shortText"
        }
      }
    },
    "axisMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "meaning",
        "evidenceQuestionOrdinals"
      ],
      "properties": {
        "axis": {
          "$ref": "#/$defs/shortText"
        },
        "meaning": {
          "$ref": "#/$defs/boundedText"
        },
        "evidenceQuestionOrdinals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/questionOrdinal"
          }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "path",
        "reason",
        "nextAction"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "path": {
          "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/fieldPath"
        },
        "reason": {
          "$ref": "#/$defs/boundedText"
        },
        "nextAction": {
          "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/semanticId"
        }
      }
    }
  }
}
