{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey:schema:question-frame-set:v1alpha1",
  "title": "Mission Kit QuestionFrameSet resource v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "survey.mission-kit/v1alpha1"
    },
    "kind": {
      "const": "QuestionFrameSet"
    },
    "metadata": {
      "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roundRef",
        "roundOrdinal",
        "parentFrameRef",
        "slots",
        "coverageRationale",
        "orthogonalityRationale"
      ],
      "properties": {
        "roundRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/SurveyRoundReference"
        },
        "roundOrdinal": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/roundOrdinal"
        },
        "parentFrameRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/ContextFrameReference"
        },
        "slots": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/frameSlot"
          }
        },
        "coverageRationale": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/rationale"
        },
        "orthogonalityRationale": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/rationale"
        }
      }
    }
  },
  "$defs": {
    "frameSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "questionOrdinal",
        "contextFrameRef",
        "parentFrameRef",
        "scopeRelation",
        "containmentRationale",
        "intentDimension",
        "outcomeAxisAnchors",
        "sourceEvidenceRefs"
      ],
      "properties": {
        "slot": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/roundSlot"
        },
        "questionOrdinal": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/questionOrdinal"
        },
        "contextFrameRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/ContextFrameReference"
        },
        "parentFrameRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/ContextFrameReference"
        },
        "scopeRelation": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/scopeRelation"
        },
        "containmentRationale": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/rationale"
        },
        "intentDimension": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/shortText"
        },
        "outcomeAxisAnchors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/axisAnchor"
          }
        },
        "sourceEvidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/resourceReference"
          }
        },
        "round1Relation": {
          "$ref": "#/$defs/round1Relation"
        }
      }
    },
    "round1Relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpretationRef",
        "relation",
        "rationale"
      ],
      "properties": {
        "interpretationRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/RoundInterpretationReference"
        },
        "relation": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/roundOneRelation"
        },
        "rationale": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/rationale"
        }
      }
    }
  }
}
