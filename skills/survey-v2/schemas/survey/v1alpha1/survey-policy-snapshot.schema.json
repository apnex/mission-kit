{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:survey:schema:survey-policy-snapshot:v1alpha1",
  "title": "Mission Kit SurveyPolicySnapshot resource v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "survey.mission-kit/v1alpha1"
    },
    "kind": {
      "const": "SurveyPolicySnapshot"
    },
    "metadata": {
      "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileRef",
        "geometry",
        "disclosure",
        "generation",
        "validation",
        "contextSelection"
      ],
      "properties": {
        "profileRef": {
          "$ref": "urn:mission-kit:survey:schema:common:v1alpha1#/$defs/AuthoringProfileManifestReference"
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "disclosure": {
          "$ref": "#/$defs/disclosure"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "validation": {
          "$ref": "#/$defs/validation"
        },
        "contextSelection": {
          "$ref": "#/$defs/contextSelection"
        }
      }
    }
  },
  "$defs": {
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rounds",
        "questionsPerRound",
        "totalQuestions",
        "choiceOptions"
      ],
      "properties": {
        "rounds": {
          "const": 2
        },
        "questionsPerRound": {
          "const": 3
        },
        "totalQuestions": {
          "const": 6
        },
        "choiceOptions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "maximum"
          ],
          "properties": {
            "minimum": {
              "const": 3
            },
            "maximum": {
              "const": 4
            }
          }
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "siblingQuestionFramesVisible",
        "futureQuestionsVisible",
        "interimInterpretationVisible"
      ],
      "properties": {
        "mode": {
          "const": "single-current-question"
        },
        "siblingQuestionFramesVisible": {
          "const": false
        },
        "futureQuestionsVisible": {
          "const": false
        },
        "interimInterpretationVisible": {
          "const": false
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionFrameSetSize",
        "questionSetSize",
        "questionResourceType",
        "contextFrameResourceType",
        "roundTwoRelations"
      ],
      "properties": {
        "questionFrameSetSize": {
          "const": 3
        },
        "questionSetSize": {
          "const": 3
        },
        "questionResourceType": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "apiVersion",
            "kind"
          ],
          "properties": {
            "apiVersion": {
              "const": "schemas.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "Question"
            }
          }
        },
        "contextFrameResourceType": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "apiVersion",
            "kind"
          ],
          "properties": {
            "apiVersion": {
              "const": "schemas.mission-kit/v1alpha1"
            },
            "kind": {
              "const": "ContextFrame"
            }
          }
        },
        "roundTwoRelations": {
          "const": [
            "refines",
            "challenges",
            "disambiguates",
            "deepens"
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rationaleRequired",
        "authority",
        "schemaBindings",
        "validatorBindings"
      ],
      "properties": {
        "rationaleRequired": {
          "const": true
        },
        "authority": {
          "const": "mechanical-only"
        },
        "schemaBindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DigestBinding"
          }
        },
        "validatorBindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DigestBinding"
          }
        }
      }
    },
    "contextSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserveLayerRoles",
        "allowInlineRuntimeState",
        "selectors"
      ],
      "properties": {
        "preserveLayerRoles": {
          "const": true
        },
        "allowInlineRuntimeState": {
          "const": false
        },
        "selectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "urn:mission-kit:authoring:schema:common:v1alpha1#/$defs/DigestBinding"
          }
        }
      }
    }
  }
}
