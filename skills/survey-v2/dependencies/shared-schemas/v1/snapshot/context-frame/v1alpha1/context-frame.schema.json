{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:schemas:context-frame:v1alpha1",
  "title": "Mission Kit ContextFrame resource v1alpha1",
  "description": "A process-neutral, declarative semantic context resource.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "schemas.mission-kit/v1alpha1"
    },
    "kind": {
      "const": "ContextFrame"
    },
    "metadata": {
      "$ref": "urn:mission-kit:schemas:common:resource-metadata:v1alpha1"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "purpose",
        "scope",
        "givens",
        "synopsis",
        "terms"
      ],
      "properties": {
        "subject": {
          "description": "The thing being framed.",
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "purpose": {
          "description": "Why judgment about the subject is required.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "givens": {
          "description": "Ordered statements accepted as facts, assumptions, or constraints within this context.",
          "type": "array",
          "minItems": 0,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/given"
          }
        },
        "synopsis": {
          "description": "Exact bounded wording suitable for deterministic projection.",
          "type": "string",
          "minLength": 1,
          "maxLength": 320,
          "pattern": "\\S"
        },
        "terms": {
          "description": "Ordered definitions for terms whose meaning is fixed within this context.",
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/term"
          }
        }
      }
    }
  },
  "$defs": {
    "boundary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "pattern": "\\S"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded"
      ],
      "properties": {
        "included": {
          "description": "Ordered boundaries that are inside this context.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/boundary"
          }
        },
        "excluded": {
          "description": "Ordered boundaries that are outside this context.",
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/boundary"
          }
        }
      }
    },
    "given": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "text"
      ],
      "properties": {
        "classification": {
          "enum": [
            "fact",
            "assumption",
            "constraint"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "meaning"
      ],
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "pattern": "\\S"
        }
      }
    }
  }
}
