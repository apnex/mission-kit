{
  "id": "survey.director.current-question/v1",
  "outputSchema": {
    "id": "urn:mission-kit:survey-v2:schema:question-presentation:v2",
    "schemaVersion": "2.0.0"
  },
  "projection": {
    "absencePreservation": [
      {
        "rule": "omit-target-when-source-absent",
        "source": {
          "ordinal": 4,
          "path": "/spec/prompt/instruction"
        },
        "target": "/prompt/instruction"
      }
    ],
    "constants": [
      {
        "target": "/kind",
        "value": "question"
      },
      {
        "target": "/responseGuidance/syntax",
        "value": "Pick one or more option letters."
      }
    ],
    "derivedMappings": [
      {
        "expression": "Q${questionOrdinal}",
        "source": "/unit/questionOrdinal",
        "target": "/questionId"
      }
    ],
    "targetMappings": [
      {
        "source": {
          "ordinal": 1,
          "path": "/spec/synopsis"
        },
        "target": "/context/surveySynopsis"
      },
      {
        "source": {
          "ordinal": 2,
          "path": "/spec/synopsis"
        },
        "target": "/context/roundSynopsis"
      },
      {
        "source": {
          "ordinal": 3,
          "path": "/spec/synopsis"
        },
        "target": "/context/questionSynopsis"
      },
      {
        "source": {
          "ordinal": 4,
          "path": "/spec/prompt"
        },
        "target": "/prompt"
      },
      {
        "source": {
          "ordinal": 4,
          "path": "/spec/response/options"
        },
        "target": "/options"
      },
      {
        "source": {
          "ordinal": 4,
          "path": "/spec/response/cardinality"
        },
        "target": "/responseGuidance",
        "transform": "copy-minimum-and-maximum"
      }
    ]
  },
  "schemaVersion": "1.0.0",
  "sourceSelections": [
    {
      "ordinal": 1,
      "paths": [
        "/spec/synopsis"
      ],
      "role": "survey-frame"
    },
    {
      "ordinal": 2,
      "paths": [
        "/spec/synopsis"
      ],
      "role": "round-frame"
    },
    {
      "ordinal": 3,
      "paths": [
        "/spec/synopsis"
      ],
      "role": "question-frame"
    },
    {
      "ordinal": 4,
      "paths": [
        "/spec/prompt",
        "/spec/response/options",
        "/spec/response/cardinality"
      ],
      "role": "question"
    }
  ],
  "viewKind": "question"
}
