{
  "apiVersion": "authoring.mission-kit/v1alpha1",
  "kind": "AuthoringProtocol",
  "metadata": {
    "name": "survey-v2-authoring"
  },
  "spec": {
    "initialState": "new",
    "states": [
      {
        "id": "new",
        "label": "New",
        "class": "wait"
      },
      {
        "id": "survey_frame_required",
        "label": "Author Survey frame",
        "class": "task",
        "taskId": "author-survey-frame"
      },
      {
        "id": "round_1_frame_required",
        "label": "Author Round 1 frame",
        "class": "task",
        "taskId": "author-round-1-frame"
      },
      {
        "id": "round_1_question_frames_required",
        "label": "Author Round 1 question frame set",
        "class": "task",
        "taskId": "author-round-1-frame-set"
      },
      {
        "id": "round_1_questions_required",
        "label": "Author Round 1 questions",
        "class": "task",
        "taskId": "author-round-1-questions"
      },
      {
        "id": "waiting_for_round_1_responses",
        "label": "Wait for Round 1 responses",
        "class": "wait"
      },
      {
        "id": "round_1_interpretation_required",
        "label": "Author Round 1 interpretation",
        "class": "task",
        "taskId": "author-round-1-interpretation"
      },
      {
        "id": "waiting_for_round_2_design",
        "label": "Wait for Round 2 design",
        "class": "wait"
      },
      {
        "id": "round_2_frame_required",
        "label": "Author Round 2 frame",
        "class": "task",
        "taskId": "author-round-2-frame"
      },
      {
        "id": "round_2_question_frames_required",
        "label": "Author Round 2 question frame set",
        "class": "task",
        "taskId": "author-round-2-frame-set"
      },
      {
        "id": "round_2_questions_required",
        "label": "Author Round 2 questions",
        "class": "task",
        "taskId": "author-round-2-questions"
      },
      {
        "id": "waiting_for_round_2_responses",
        "label": "Wait for Round 2 responses",
        "class": "wait"
      },
      {
        "id": "round_2_interpretation_required",
        "label": "Author Round 2 interpretation",
        "class": "task",
        "taskId": "author-round-2-interpretation"
      },
      {
        "id": "waiting_for_composite_phase",
        "label": "Wait for composite phase",
        "class": "wait"
      },
      {
        "id": "composite_required",
        "label": "Author composite",
        "class": "task",
        "taskId": "author-composite"
      },
      {
        "id": "candidate_ready",
        "label": "Candidate ready",
        "class": "wait"
      },
      {
        "id": "complete",
        "label": "Complete",
        "class": "terminal"
      },
      {
        "id": "aborted",
        "label": "Aborted",
        "class": "terminal"
      }
    ],
    "events": [
      {
        "id": "BEGIN_AUTHORING",
        "description": "Begin authoring from initialized Survey inputs"
      },
      {
        "id": "SUBMIT_SURVEY_FRAME",
        "description": "Submit the complete Survey frame unit"
      },
      {
        "id": "SUBMIT_ROUND_1_FRAME",
        "description": "Submit the complete Round 1 frame unit"
      },
      {
        "id": "SUBMIT_ROUND_1_FRAME_SET",
        "description": "Submit the complete Round 1 question frame set"
      },
      {
        "id": "SUBMIT_ROUND_1_QUESTIONS",
        "description": "Submit the complete Round 1 instrument unit"
      },
      {
        "id": "BEGIN_R1_INTERPRETATION_AUTHORING",
        "description": "Begin Round 1 interpretation authoring"
      },
      {
        "id": "SUBMIT_ROUND_1_INTERPRETATION",
        "description": "Submit the complete Round 1 interpretation"
      },
      {
        "id": "BEGIN_R2_AUTHORING",
        "description": "Begin Round 2 authoring from sealed Round 1 meaning"
      },
      {
        "id": "SUBMIT_ROUND_2_FRAME",
        "description": "Submit the complete Round 2 frame unit"
      },
      {
        "id": "SUBMIT_ROUND_2_FRAME_SET",
        "description": "Submit the complete Round 2 question frame set"
      },
      {
        "id": "SUBMIT_ROUND_2_QUESTIONS",
        "description": "Submit the complete Round 2 instrument unit"
      },
      {
        "id": "BEGIN_R2_INTERPRETATION_AUTHORING",
        "description": "Begin Round 2 interpretation authoring"
      },
      {
        "id": "SUBMIT_ROUND_2_INTERPRETATION",
        "description": "Submit the complete Round 2 interpretation"
      },
      {
        "id": "BEGIN_COMPOSITE_AUTHORING",
        "description": "Begin composite authoring from sealed interpretations"
      },
      {
        "id": "SUBMIT_COMPOSITE",
        "description": "Submit the complete composite candidate"
      },
      {
        "id": "CLOSE_AUTHORING",
        "description": "Close authoring after the exact terminal handoff"
      },
      {
        "id": "REOPEN_COMPOSITE_AFTER_VALIDATION",
        "description": "Reopen composite authoring after candidate validation failure"
      },
      {
        "id": "REOPEN_COMPOSITE_AFTER_RETURN",
        "description": "Reopen composite authoring after Director return"
      },
      {
        "id": "REOPEN_R2_INTERPRETATION",
        "description": "Reopen Round 2 interpretation after Director return"
      },
      {
        "id": "REOPEN_COMPOSITE_AFTER_FINALIZATION",
        "description": "Reopen composite authoring after finalization invalidation"
      },
      {
        "id": "REOPEN_R2_AFTER_FINALIZATION",
        "description": "Reopen Round 2 interpretation after finalization invalidation"
      },
      {
        "id": "ABORT_AUTHORING",
        "description": "Abort authoring with exact coupled abort evidence"
      }
    ],
    "guards": [
      {
        "id": "initialized-survey-inputs",
        "description": "Initialized Survey inputs are complete and exact"
      },
      {
        "id": "current-survey-frame-assignment",
        "description": "The current Survey frame assignment is exact"
      },
      {
        "id": "frozen-survey-frame",
        "description": "The exact Survey frame is frozen"
      },
      {
        "id": "frozen-round-1-parent-closure",
        "description": "The exact Round 1 parent closure is frozen"
      },
      {
        "id": "frozen-round-1-frame-set",
        "description": "The complete Round 1 frame set is frozen"
      },
      {
        "id": "exact-round-1-responses",
        "description": "The complete Round 1 response artifact is exact"
      },
      {
        "id": "exact-round-1-interpretation-ancestry",
        "description": "The Round 1 interpretation ancestry is exact"
      },
      {
        "id": "sealed-round-1-interpretation",
        "description": "The exact Round 1 interpretation is sealed"
      },
      {
        "id": "round-2-frame-ancestry",
        "description": "Survey frame and sealed Round 1 meaning are exact"
      },
      {
        "id": "frozen-round-2-parent-closure",
        "description": "The exact Round 2 parent closure is frozen"
      },
      {
        "id": "frozen-round-2-frame-set",
        "description": "The complete Round 2 frame set is frozen"
      },
      {
        "id": "exact-round-2-responses",
        "description": "The complete Round 2 response artifact is exact"
      },
      {
        "id": "exact-round-2-interpretation-ancestry",
        "description": "The Round 2 interpretation ancestry is exact"
      },
      {
        "id": "sealed-interpretation-pair",
        "description": "Both exact Round interpretations are sealed"
      },
      {
        "id": "complete-composite-ancestry",
        "description": "The composite candidate ancestry is complete and exact"
      },
      {
        "id": "exact-terminal-handoff",
        "description": "The terminal handoff is exact"
      },
      {
        "id": "candidate-validation-evidence",
        "description": "CandidateValidationEvidence is exact and immutable"
      },
      {
        "id": "composite-revision-directive",
        "description": "The composite RevisionDirective is exact and immutable"
      },
      {
        "id": "round-2-revision-directive",
        "description": "The Round 2 RevisionDirective is exact and immutable"
      },
      {
        "id": "composite-finalization-diagnostic",
        "description": "The composite FinalizationDiagnostic is exact and immutable"
      },
      {
        "id": "round-2-finalization-diagnostic",
        "description": "The Round 2 FinalizationDiagnostic is exact and immutable"
      },
      {
        "id": "exact-abort-evidence",
        "description": "Abort evidence and the coupled phase admission are exact"
      }
    ],
    "transitions": [
      {
        "id": "AT01",
        "source": {
          "mode": "single",
          "stateId": "new"
        },
        "eventId": "BEGIN_AUTHORING",
        "toState": "survey_frame_required",
        "guardIds": [
          "initialized-survey-inputs"
        ]
      },
      {
        "id": "AT02",
        "source": {
          "mode": "single",
          "stateId": "survey_frame_required"
        },
        "eventId": "SUBMIT_SURVEY_FRAME",
        "toState": "round_1_frame_required",
        "guardIds": [
          "current-survey-frame-assignment"
        ]
      },
      {
        "id": "AT03",
        "source": {
          "mode": "single",
          "stateId": "round_1_frame_required"
        },
        "eventId": "SUBMIT_ROUND_1_FRAME",
        "toState": "round_1_question_frames_required",
        "guardIds": [
          "frozen-survey-frame"
        ]
      },
      {
        "id": "AT04",
        "source": {
          "mode": "single",
          "stateId": "round_1_question_frames_required"
        },
        "eventId": "SUBMIT_ROUND_1_FRAME_SET",
        "toState": "round_1_questions_required",
        "guardIds": [
          "frozen-round-1-parent-closure"
        ]
      },
      {
        "id": "AT05",
        "source": {
          "mode": "single",
          "stateId": "round_1_questions_required"
        },
        "eventId": "SUBMIT_ROUND_1_QUESTIONS",
        "toState": "waiting_for_round_1_responses",
        "guardIds": [
          "frozen-round-1-frame-set"
        ]
      },
      {
        "id": "AT06",
        "source": {
          "mode": "single",
          "stateId": "waiting_for_round_1_responses"
        },
        "eventId": "BEGIN_R1_INTERPRETATION_AUTHORING",
        "toState": "round_1_interpretation_required",
        "guardIds": [
          "exact-round-1-responses"
        ]
      },
      {
        "id": "AT07",
        "source": {
          "mode": "single",
          "stateId": "round_1_interpretation_required"
        },
        "eventId": "SUBMIT_ROUND_1_INTERPRETATION",
        "toState": "waiting_for_round_2_design",
        "guardIds": [
          "exact-round-1-interpretation-ancestry"
        ]
      },
      {
        "id": "AT08",
        "source": {
          "mode": "single",
          "stateId": "waiting_for_round_2_design"
        },
        "eventId": "BEGIN_R2_AUTHORING",
        "toState": "round_2_frame_required",
        "guardIds": [
          "sealed-round-1-interpretation"
        ]
      },
      {
        "id": "AT09",
        "source": {
          "mode": "single",
          "stateId": "round_2_frame_required"
        },
        "eventId": "SUBMIT_ROUND_2_FRAME",
        "toState": "round_2_question_frames_required",
        "guardIds": [
          "round-2-frame-ancestry"
        ]
      },
      {
        "id": "AT10",
        "source": {
          "mode": "single",
          "stateId": "round_2_question_frames_required"
        },
        "eventId": "SUBMIT_ROUND_2_FRAME_SET",
        "toState": "round_2_questions_required",
        "guardIds": [
          "frozen-round-2-parent-closure"
        ]
      },
      {
        "id": "AT11",
        "source": {
          "mode": "single",
          "stateId": "round_2_questions_required"
        },
        "eventId": "SUBMIT_ROUND_2_QUESTIONS",
        "toState": "waiting_for_round_2_responses",
        "guardIds": [
          "frozen-round-2-frame-set"
        ]
      },
      {
        "id": "AT12",
        "source": {
          "mode": "single",
          "stateId": "waiting_for_round_2_responses"
        },
        "eventId": "BEGIN_R2_INTERPRETATION_AUTHORING",
        "toState": "round_2_interpretation_required",
        "guardIds": [
          "exact-round-2-responses"
        ]
      },
      {
        "id": "AT13",
        "source": {
          "mode": "single",
          "stateId": "round_2_interpretation_required"
        },
        "eventId": "SUBMIT_ROUND_2_INTERPRETATION",
        "toState": "waiting_for_composite_phase",
        "guardIds": [
          "exact-round-2-interpretation-ancestry"
        ]
      },
      {
        "id": "AT14",
        "source": {
          "mode": "single",
          "stateId": "waiting_for_composite_phase"
        },
        "eventId": "BEGIN_COMPOSITE_AUTHORING",
        "toState": "composite_required",
        "guardIds": [
          "sealed-interpretation-pair"
        ]
      },
      {
        "id": "AT15",
        "source": {
          "mode": "single",
          "stateId": "composite_required"
        },
        "eventId": "SUBMIT_COMPOSITE",
        "toState": "candidate_ready",
        "guardIds": [
          "complete-composite-ancestry"
        ]
      },
      {
        "id": "AT16",
        "source": {
          "mode": "single",
          "stateId": "candidate_ready"
        },
        "eventId": "CLOSE_AUTHORING",
        "toState": "complete",
        "guardIds": [
          "exact-terminal-handoff"
        ]
      },
      {
        "id": "AC01",
        "source": {
          "mode": "single",
          "stateId": "candidate_ready"
        },
        "eventId": "REOPEN_COMPOSITE_AFTER_VALIDATION",
        "toState": "composite_required",
        "guardIds": [
          "candidate-validation-evidence"
        ]
      },
      {
        "id": "AC02",
        "source": {
          "mode": "single",
          "stateId": "candidate_ready"
        },
        "eventId": "REOPEN_COMPOSITE_AFTER_RETURN",
        "toState": "composite_required",
        "guardIds": [
          "composite-revision-directive"
        ]
      },
      {
        "id": "AC03",
        "source": {
          "mode": "single",
          "stateId": "candidate_ready"
        },
        "eventId": "REOPEN_R2_INTERPRETATION",
        "toState": "round_2_interpretation_required",
        "guardIds": [
          "round-2-revision-directive"
        ]
      },
      {
        "id": "AC04",
        "source": {
          "mode": "single",
          "stateId": "candidate_ready"
        },
        "eventId": "REOPEN_COMPOSITE_AFTER_FINALIZATION",
        "toState": "composite_required",
        "guardIds": [
          "composite-finalization-diagnostic"
        ]
      },
      {
        "id": "AC05",
        "source": {
          "mode": "single",
          "stateId": "candidate_ready"
        },
        "eventId": "REOPEN_R2_AFTER_FINALIZATION",
        "toState": "round_2_interpretation_required",
        "guardIds": [
          "round-2-finalization-diagnostic"
        ]
      },
      {
        "id": "AF01",
        "source": {
          "mode": "set",
          "stateIds": [
            "candidate_ready",
            "composite_required",
            "new",
            "round_1_frame_required",
            "round_1_interpretation_required",
            "round_1_question_frames_required",
            "round_1_questions_required",
            "round_2_frame_required",
            "round_2_interpretation_required",
            "round_2_question_frames_required",
            "round_2_questions_required",
            "survey_frame_required",
            "waiting_for_composite_phase",
            "waiting_for_round_1_responses",
            "waiting_for_round_2_design",
            "waiting_for_round_2_responses"
          ]
        },
        "eventId": "ABORT_AUTHORING",
        "toState": "aborted",
        "guardIds": [
          "exact-abort-evidence"
        ]
      }
    ]
  }
}
