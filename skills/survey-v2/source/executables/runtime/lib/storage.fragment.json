{
  "$schema": "urn:mission-kit:survey-v2:schema:fragment:v1",
  "schemaVersion": "1.0.0",
  "id": "urn:mission-kit:survey-v2:executable:runtime:storage",
  "revision": 1,
  "purpose": "Persist hash-chained sessions atomically and publish create-once quarantine latches.",
  "role": "executable",
  "normativity": "normative",
