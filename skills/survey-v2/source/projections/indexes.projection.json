{
  "$schema": "urn:mission-kit:survey-v2:schema:projection:v1",
  "schemaVersion": "1.0.0",
  "id": "urn:mission-kit:survey-v2:projection:indexes",
  "renderer": "indexes",
  "targets": [
    "generated/dependency-index.json",
    "generated/mechanism-index.json"
  ],
  "selection": {
    "fragmentIds": [
      "urn:mission-kit:survey-v2:fragment:composition:fragment-contract",
      "urn:mission-kit:survey-v2:fragment:dependencies:typed-resolution"
    ],
    "sourcePaths": [
      "source/requirements/survey-v2.requirements.json",
      "source/dependencies/references/mission-kit-axioms.reference.json",
      "source/dependencies/processes/axiom-applicability.process.json"
    ]
  },
  "budget": {
    "maxLines": 5000,
    "maxWords": 30000
  }
}
