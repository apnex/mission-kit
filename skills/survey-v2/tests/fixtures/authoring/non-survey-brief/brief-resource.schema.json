{
  "$id": "urn:mission-kit:fixture:non-survey-brief:schema:resources:v1alpha1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Non-Survey Brief profile resources",
  "oneOf": [
    {
      "$ref": "#/$defs/BriefIntake"
    },
    {
      "$ref": "#/$defs/BriefConstraints"
    },
    {
      "$ref": "#/$defs/BriefOutline"
    },
    {
      "$ref": "#/$defs/Brief"
    }
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$",
          "maxLength": 160
        }
      }
    },
    "BriefIntake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "const": "brief.example/v1alpha1"
        },
        "kind": {
          "const": "BriefIntake"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "problem",
            "audience"
          ],
          "properties": {
            "problem": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "audience": {
              "type": "string",
              "minLength": 1,
              "maxLength": 280
            }
          }
        }
      }
    },
    "BriefConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "const": "brief.example/v1alpha1"
        },
        "kind": {
          "const": "BriefConstraints"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxWords",
            "tone"
          ],
          "properties": {
            "maxWords": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "tone": {
              "enum": [
                "direct",
                "balanced",
                "exploratory"
              ]
            }
          }
        }
      }
    },
    "BriefOutline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "const": "brief.example/v1alpha1"
        },
        "kind": {
          "const": "BriefOutline"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objective"
          ],
          "properties": {
            "objective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      }
    },
    "Brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "properties": {
        "apiVersion": {
          "const": "brief.example/v1alpha1"
        },
        "kind": {
          "const": "Brief"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objective",
            "summary"
          ],
          "properties": {
            "objective": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        }
      }
    }
  }
}
