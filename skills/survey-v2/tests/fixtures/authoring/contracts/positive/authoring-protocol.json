{
  "apiVersion": "authoring.mission-kit/v1alpha1",
  "kind": "AuthoringProtocol",
  "metadata": {
    "name": "brief-flow"
  },
  "spec": {
    "initialState": "draft_task",
    "states": [
      {
        "id": "draft_task",
        "label": "Draft brief",
        "class": "task",
        "taskId": "draft-brief"
      },
      {
        "id": "awaiting_acceptance",
        "label": "Await acceptance",
        "class": "wait"
      },
      {
        "id": "complete",
        "label": "Complete",
        "class": "terminal"
      }
    ],
    "events": [
      {
        "id": "SUBMIT",
        "description": "Submit authored values"
      },
      {
        "id": "ACCEPT",
        "description": "Accept committed values"
      },
      {
        "id": "REVISE",
        "description": "Replace a committed value"
      }
    ],
    "guards": [
      {
        "id": "payload-valid",
        "description": "Normalized values satisfy the pinned contract"
      }
    ],
    "transitions": [
      {
        "id": "AT01",
        "source": {
          "mode": "single",
          "stateId": "draft_task"
        },
        "eventId": "SUBMIT",
        "toState": "awaiting_acceptance",
        "guardIds": [
          "payload-valid"
        ]
      },
      {
        "id": "AT02",
        "source": {
          "mode": "single",
          "stateId": "awaiting_acceptance"
        },
        "eventId": "ACCEPT",
        "toState": "complete",
        "guardIds": []
      }
    ]
  }
}
