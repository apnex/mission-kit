{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mission-kit:schemas:question:choice-response:v1alpha1",
  "title": "Mission Kit Choice response specification v1alpha1",
  "description": "An ordered set of answer options with explicit selection cardinality and constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "cardinality",
    "options",
    "constraints"
  ],
  "properties": {
    "type": {
      "const": "Choice"
    },
    "cardinality": {
      "$ref": "#/$defs/cardinality"
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "constraints": {
      "description": "Explicit relationships that further restrict otherwise valid selections.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/constraint"
      }
    }
  },
  "$defs": {
    "optionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[-a-z0-9._:]*[a-z0-9])?$"
    },
    "cardinality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "meaning"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/optionId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "constraint": {
      "oneOf": [
        {
          "$ref": "#/$defs/mutuallyExclusiveConstraint"
        }
      ]
    },
    "mutuallyExclusiveConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "optionIds"
      ],
      "properties": {
        "type": {
          "const": "MutuallyExclusive"
        },
        "optionIds": {
          "description": "A set from which no more than one option may be selected.",
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/optionId"
          }
        }
      }
    }
  }
}
